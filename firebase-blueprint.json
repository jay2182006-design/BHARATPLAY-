{
  "entities": {
    "UserPublicProfile": {
      "title": "UserPublicProfile",
      "description": "Public channel and creator profile visible across BharatPlay.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "handle": { "type": "string", "minLength": 2, "maxLength": 40, "pattern": "^[a-zA-Z0-9_\\.\\-]+$" },
        "bio": { "type": "string", "maxLength": 500 },
        "avatarUrl": { "type": "string", "maxLength": 500 },
        "bannerUrl": { "type": "string", "maxLength": 500 },
        "isCreator": { "type": "boolean" },
        "isEarlyCreator": { "type": "boolean" },
        "isVerified": { "type": "boolean" },
        "isFeatured": { "type": "boolean" },
        "boostEnabled": { "type": "boolean" },
        "leagueCategory": { "type": "string", "maxLength": 40 },
        "preferredLanguage": { "type": "string", "maxLength": 30 },
        "subscribersCount": { "type": "number" },
        "totalViews": { "type": "number" },
        "rewardTier": { "type": "string", "enum": ["Seed", "Rising", "Star", "Icon"] },
        "accountStatus": { "type": "string", "enum": ["active", "suspended", "deleted"] },
        "channelStatus": { "type": "string", "enum": ["active", "suspended", "deleted"] },
        "moderationReason": { "type": "string", "maxLength": 500 },
        "statusUpdatedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "handle", "isCreator", "createdAt", "updatedAt"]
    },
    "UserPrivateAccount": {
      "title": "UserPrivateAccount",
      "description": "Private user account details including PII, role, monetization settings, and notifications preference.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "role": { "type": "string", "enum": ["viewer", "creator", "admin", "ceo"] },
        "monetizationEnabled": { "type": "boolean" },
        "estimatedEarningsInr": { "type": "number" },
        "availableBalanceInr": { "type": "number" },
        "pendingBalanceInr": { "type": "number" },
        "lifetimeEarningsInr": { "type": "number" },
        "monetizationTermsAcceptedAt": { "type": "string" },
        "upiId": { "type": "string", "maxLength": 100 },
        "notificationsEnabled": { "type": "boolean" },
        "themePreference": { "type": "string", "enum": ["dark", "light"] },
        "suspended": { "type": "boolean" },
        "suspensionReason": { "type": "string", "maxLength": 500 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "updatedAt"]
    },
    "AdminRole": {
      "title": "AdminRole",
      "description": "Trusted server-verified admin role document with explicit CEO-granted permissions.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 80 },
        "email": { "type": "string", "maxLength": 160 },
        "permissions": {
          "type": "object",
          "properties": {
            "moderateVideos": { "type": "boolean" },
            "resolveReports": { "type": "boolean" },
            "manageCreators": { "type": "boolean" },
            "manageCompetitions": { "type": "boolean" },
            "manageAnnouncements": { "type": "boolean" },
            "manageCategories": { "type": "boolean" },
            "manageMonetization": { "type": "boolean" }
          },
          "required": ["moderateVideos", "resolveReports", "manageCreators", "manageCompetitions", "manageAnnouncements", "manageCategories"]
        },
        "grantedBy": { "type": "string", "maxLength": 128 },
        "notes": { "type": "string", "maxLength": 300 },
        "grantedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "permissions", "grantedBy", "grantedAt", "updatedAt"]
    },
    "CeoRole": {
      "title": "CeoRole",
      "description": "Exclusive CEO clearance marker document accessible only to the verified platform CEO.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "clearanceLevel": { "type": "string", "enum": ["CEO"] },
        "grantedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "clearanceLevel", "grantedAt"]
    },
    "CeoAuditLog": {
      "title": "CeoAuditLog",
      "description": "Immutable, permanent audit trail of all CEO and Admin governance actions.",
      "type": "object",
      "properties": {
        "actorUid": { "type": "string", "maxLength": 128 },
        "actorEmail": { "type": "string", "maxLength": 160 },
        "actorRole": { "type": "string", "enum": ["ceo", "admin"] },
        "action": { "type": "string", "minLength": 2, "maxLength": 80 },
        "targetType": { "type": "string", "enum": ["user", "channel", "video", "report", "announcement", "system", "admin", "payout", "config", "competition", "challenge", "monetization", "dispute", "traffic", "brand", "payment"] },
        "targetId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "targetLabel": { "type": "string", "maxLength": 150 },
        "reason": { "type": "string", "minLength": 2, "maxLength": 500 },
        "status": { "type": "string", "enum": ["success", "blocked", "failed"] },
        "details": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["actorUid", "action", "targetType", "targetId", "reason", "status", "createdAt"]
    },
    "CreatorPayout": {
      "title": "CreatorPayout",
      "description": "Creator payout requests and CEO-processed UPI payout ledger.",
      "type": "object",
      "properties": {
        "creatorId": { "type": "string", "maxLength": 128 },
        "creatorName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "creatorHandle": { "type": "string", "maxLength": 40 },
        "upiId": { "type": "string", "minLength": 3, "maxLength": 100 },
        "amountInr": { "type": "number" },
        "periodLabel": { "type": "string", "maxLength": 60 },
        "status": { "type": "string", "enum": ["pending", "approved", "paid", "rejected"] },
        "notes": { "type": "string", "maxLength": 300 },
        "processedByUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["creatorId", "creatorName", "upiId", "amountInr", "status", "createdAt", "updatedAt"]
    },
    "Video": {
      "title": "Video",
      "description": "Video or Bharat Short metadata referencing scalable media storage URLs.",
      "type": "object",
      "properties": {
        "creatorId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "creatorName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "creatorAvatar": { "type": "string", "maxLength": 500 },
        "title": { "type": "string", "minLength": 2, "maxLength": 150 },
        "description": { "type": "string", "maxLength": 3000 },
        "videoUrl": { "type": "string", "minLength": 1, "maxLength": 500 },
        "thumbnailUrl": { "type": "string", "maxLength": 500 },
        "type": { "type": "string", "enum": ["video", "short"] },
        "category": { "type": "string", "maxLength": 50 },
        "language": { "type": "string", "maxLength": 30 },
        "durationSeconds": { "type": "number" },
        "musicTrack": { "type": "string", "maxLength": 120 },
        "challengeId": { "type": "string", "maxLength": 128 },
        "tags": { "type": "array" },
        "chapters": { "type": "array" },
        "accessType": { "type": "string", "enum": ["free", "members_only", "paid"] },
        "priceInr": { "type": "number" },
        "adsEnabled": { "type": "boolean" },
        "adEligibility": { "type": "string", "enum": ["eligible", "limited", "ineligible"] },
        "viewsCount": { "type": "number" },
        "uniqueViewersCount": { "type": "number" },
        "totalWatchSeconds": { "type": "number" },
        "likesCount": { "type": "number" },
        "dislikesCount": { "type": "number" },
        "commentsCount": { "type": "number" },
        "sharesCount": { "type": "number" },
        "status": { "type": "string", "enum": ["published", "flagged", "removed"] },
        "removalReason": { "type": "string", "maxLength": 500 },
        "removedBy": { "type": "string", "maxLength": 128 },
        "isTrending": { "type": "boolean" },
        "isEarlyCreatorSpotlight": { "type": "boolean" },
        "isOriginal": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["creatorId", "creatorName", "title", "videoUrl", "type", "category", "language", "status", "createdAt", "updatedAt"]
    },
    "VideoComment": {
      "title": "VideoComment",
      "description": "Comment or reply on a video or short.",
      "type": "object",
      "properties": {
        "videoId": { "type": "string", "maxLength": 128 },
        "authorId": { "type": "string", "maxLength": 128 },
