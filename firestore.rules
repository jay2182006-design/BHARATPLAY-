          incoming().diff(existing()).affectedKeys().hasOnly(['categories', 'updatedAt'])
        )
      );
      allow delete: if isValidId(configId) && isCEO();
    }

    // --- Creator Monetization System Collections ---

    match /adRevenueRecords/{recordId} {
      allow get: if isValidId(recordId) && isSignedIn() && (resource.data.creatorId == request.auth.uid || hasAdminPerm('manageMonetization') || isCEO());
      allow list: if isSignedIn() && (resource.data.creatorId == request.auth.uid || isAdmin() || isCEO());
      allow create: if isValidId(recordId) && (isCEO() || hasAdminPerm('manageMonetization')) &&
        isValidAdRevenueRecord(incoming()) &&
        incoming().createdAt == request.time;
      allow update: if isValidId(recordId) && (isCEO() || hasAdminPerm('manageMonetization')) &&
        isValidAdRevenueRecord(incoming()) &&
        incoming().creatorId == existing().creatorId &&
        incoming().videoId == existing().videoId &&
        incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(recordId) && isCEO();
    }

    match /membershipPlans/{planId} {
      allow get: if isValidId(planId);
      allow list: if resource.data.isActive == true || (isSignedIn() && resource.data.creatorId == request.auth.uid) || isAdmin() || isCEO();
      allow create: if isValidId(planId) && isVerifiedUser() &&
        isValidMembershipPlan(incoming()) &&
        (isCEO() || incoming().creatorId == request.auth.uid) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(planId) && isVerifiedUser() &&
        isValidMembershipPlan(incoming()) && (
        isCEO() ||
        (
          existing().creatorId == request.auth.uid &&
          incoming().creatorId == existing().creatorId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time
        )
      );
      allow delete: if isValidId(planId) && isVerifiedUser() && (existing().creatorId == request.auth.uid || isCEO());
    }

    match /creatorMemberships/{membershipId} {
      allow get: if isValidId(membershipId) && isSignedIn() && (resource.data.memberId == request.auth.uid || resource.data.creatorId == request.auth.uid || hasAdminPerm('manageMonetization') || isCEO());
      allow list: if isSignedIn() && (resource.data.memberId == request.auth.uid || resource.data.creatorId == request.auth.uid || isAdmin() || isCEO());
      allow create: if isValidId(membershipId) && isVerifiedUser() &&
        isValidCreatorMembership(incoming()) &&
        (
          isCEO() ||
          (
            incoming().memberId == request.auth.uid &&
            incoming().paymentVerified == false &&
            incoming().status == 'pending'
          )
        ) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(membershipId) && isVerifiedUser() && isValidCreatorMembership(incoming()) && (
        isCEO() ||
        hasAdminPerm('manageMonetization') ||
        (
          existing().memberId == request.auth.uid &&
          incoming().memberId == existing().memberId &&
          incoming().creatorId == existing().creatorId &&
          incoming().paymentVerified == existing().paymentVerified &&
          incoming().status == 'cancelled' &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
        )
      );
      allow delete: if isValidId(membershipId) && isCEO();
    }

    match /brandCampaigns/{campaignId} {
      allow get: if isValidId(campaignId) && isSignedIn();
      allow list: if isSignedIn();
      allow create: if isValidId(campaignId) && (isCEO() || hasAdminPerm('manageMonetization')) &&
        isValidBrandCampaign(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(campaignId) && (isCEO() || hasAdminPerm('manageMonetization')) &&
        isValidBrandCampaign(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(campaignId) && isCEO();
    }

    match /brandApplications/{appId} {
      allow get: if isValidId(appId) && isSignedIn() && (resource.data.creatorId == request.auth.uid || hasAdminPerm('manageMonetization') || isCEO());
      allow list: if isSignedIn() && (resource.data.creatorId == request.auth.uid || isAdmin() || isCEO());
      allow create: if isValidId(appId) && isVerifiedUser() &&
        isValidBrandApplication(incoming()) &&
        incoming().creatorId == request.auth.uid &&
        incoming().status == 'applied' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(appId) && isVerifiedUser() && isValidBrandApplication(incoming()) && (
        isCEO() ||
        hasAdminPerm('manageMonetization') ||
        (
          existing().creatorId == request.auth.uid &&
          existing().status == 'approved' &&
          incoming().status == 'delivered' &&
          incoming().creatorId == existing().creatorId &&
          incoming().campaignId == existing().campaignId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['deliverableUrl', 'status', 'updatedAt'])
        )
      );
      allow delete: if isValidId(appId) && isVerifiedUser() && ((existing().creatorId == request.auth.uid && existing().status == 'applied') || isCEO());
    }

    match /affiliateLinks/{linkId} {
      allow get: if isValidId(linkId);
      allow list: if resource.data.isActive == true || (isSignedIn() && resource.data.creatorId == request.auth.uid) || isAdmin() || isCEO();
      allow create: if isValidId(linkId) && isVerifiedUser() &&
        isValidAffiliateLink(incoming()) &&
        (
          isCEO() ||
          (
            incoming().creatorId == request.auth.uid &&
            incoming().clicksCount == 0 &&
            incoming().validClicksCount == 0 &&
            incoming().conversionsCount == 0 &&
            incoming().earnedInr == 0
          )
        ) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(linkId) && isVerifiedUser() && isValidAffiliateLink(incoming()) && (
        isCEO() ||
        hasAdminPerm('manageMonetization') ||
        (
          existing().creatorId == request.auth.uid &&
          incoming().creatorId == existing().creatorId &&
          incoming().code == existing().code &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['targetUrl', 'productTitle', 'merchantName', 'commissionPercent', 'isActive', 'updatedAt'])
        )
      );
      allow delete: if isValidId(linkId) && isVerifiedUser() && (existing().creatorId == request.auth.uid || isCEO());
    }

    match /affiliateEvents/{eventId} {
      allow get: if isValidId(eventId) && isSignedIn() && (resource.data.creatorId == request.auth.uid || hasAdminPerm('manageMonetization') || isCEO());
      allow list: if isSignedIn() && (resource.data.creatorId == request.auth.uid || isAdmin() || isCEO());
      allow create: if isValidId(eventId) && (isCEO() || hasAdminPerm('manageMonetization')) &&
        isValidAffiliateEvent(incoming()) &&
        incoming().createdAt == request.time;
      allow update: if isValidId(eventId) && (isCEO() || hasAdminPerm('manageMonetization')) &&
        isValidAffiliateEvent(incoming()) &&
        incoming().creatorId == existing().creatorId &&
        incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(eventId) && isCEO();
    }

    match /videoPurchases/{purchaseId} {
      allow get: if isValidId(purchaseId) && isSignedIn() && (resource.data.buyerId == request.auth.uid || resource.data.creatorId == request.auth.uid || hasAdminPerm('manageMonetization') || isCEO());
      allow list: if isSignedIn() && (resource.data.buyerId == request.auth.uid || resource.data.creatorId == request.auth.uid || isAdmin() || isCEO());
      allow create: if isValidId(purchaseId) && isVerifiedUser() &&
        isValidVideoPurchase(incoming()) &&
        (
          isCEO() ||
          (
            incoming().buyerId == request.auth.uid &&
            incoming().paymentVerified == false &&
            incoming().status == 'pending_verification'
          )
        ) &&
        incoming().createdAt == request.time;
      allow update: if isValidId(purchaseId) && (isCEO() || hasAdminPerm('manageMonetization')) &&
        isValidVideoPurchase(incoming()) &&
        incoming().buyerId == existing().buyerId &&
        incoming().videoId == existing().videoId &&
        incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(purchaseId) && isCEO();
    }

    match /monetizationTransactions/{txId} {
      allow get: if isValidId(txId) && isSignedIn() && (resource.data.creatorId == request.auth.uid || resource.data.counterpartyId == request.auth.uid || hasAdminPerm('manageMonetization') || isCEO());
      allow list: if isSignedIn() && (resource.data.creatorId == request.auth.uid || resource.data.counterpartyId == request.auth.uid || isAdmin() || isCEO());
      allow create: if isValidId(txId) && isCEO() &&
        isValidMonetizationTransaction(incoming()) &&
        incoming().createdAt == request.time;
      allow update: if isValidId(txId) && isCEO() &&
        isValidMonetizationTransaction(incoming()) &&
        incoming().creatorId == existing().creatorId &&
        incoming().createdAt == existing().createdAt;
      allow delete: if false;
    }

    match /invalidTrafficFlags/{flagId} {
      allow get: if isValidId(flagId) && isSignedIn() && (resource.data.creatorId == request.auth.uid || hasAdminPerm('manageMonetization') || isCEO());
      allow list: if isSignedIn() && (resource.data.creatorId == request.auth.uid || isAdmin() || isCEO());
      allow create: if isValidId(flagId) && (isCEO() || hasAdminPerm('manageMonetization')) &&
        isValidInvalidTrafficFlag(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(flagId) && (isCEO() || hasAdminPerm('manageMonetization')) &&
        isValidInvalidTrafficFlag(incoming()) &&
        incoming().creatorId == existing().creatorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(flagId) && isCEO();
    }

    match /paymentDisputes/{disputeId} {
      allow get: if isValidId(disputeId) && isSignedIn() && (resource.data.reporterId == request.auth.uid || resource.data.creatorId == request.auth.uid || hasAdminPerm('manageMonetization') || isCEO());
      allow list: if isSignedIn() && (resource.data.reporterId == request.auth.uid || resource.data.creatorId == request.auth.uid || isAdmin() || isCEO());
      allow create: if isValidId(disputeId) && isVerifiedUser() &&
        isValidPaymentDispute(incoming()) &&
        incoming().reporterId == request.auth.uid &&
        incoming().status == 'open' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(disputeId) && (isCEO() || hasAdminPerm('manageMonetization')) &&
        isValidPaymentDispute(incoming()) &&
        incoming().reporterId == existing().reporterId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(disputeId) && isCEO();
    }

    match /paymentTransactions/{paymentId} {
      allow get: if isValidId(paymentId) && isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.creatorId == request.auth.uid || hasAdminPerm('manageMonetization') || isCEO());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.creatorId == request.auth.uid || isAdmin() || isCEO());
      allow create: if isValidId(paymentId) && isVerifiedUser() &&
        isValidPaymentTransaction(incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'pending_verification' &&
        incoming().serviceActivated == false &&
        !('verifiedByUid' in incoming()) &&
        !('verifiedByRole' in incoming()) &&
        !('verifiedAt' in incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(paymentId) && (isCEO() || hasAdminPerm('manageMonetization')) &&
        isValidPaymentTransaction(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().creatorId == existing().creatorId &&
        incoming().amountInr == existing().amountInr &&
        incoming().paymentMethod == existing().paymentMethod &&
        incoming().utrNumber == existing().utrNumber &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if false;
    }
  }
}
