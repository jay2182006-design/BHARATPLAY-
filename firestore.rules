rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isCEO() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/ceoRoles/$(request.auth.uid)) ||
        request.auth.token.email == 'jay2182006@gmail.com'
      );
    }

    function isAdmin() {
      return isCEO() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Only call inside get/create/update/delete — NEVER inside allow list (Pillar 8)
    function hasAdminPerm(perm) {
      return isCEO() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.permissions[perm] == true
      );
    }

    function isTargetCEO(userId) {
      return exists(/databases/$(database)/documents/ceoRoles/$(userId));
    }

    // --- Validation Blueprints ---
    function isValidPublicProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'handle', 'isCreator', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'uid', 'displayName', 'handle', 'bio', 'avatarUrl', 'bannerUrl',
          'isCreator', 'isEarlyCreator', 'isVerified', 'isFeatured', 'boostEnabled',
          'leagueCategory', 'preferredLanguage', 'subscribersCount', 'totalViews',
          'rewardTier', 'accountStatus', 'channelStatus', 'moderationReason',
          'statusUpdatedAt', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        data.handle is string && data.handle.size() >= 2 && data.handle.size() <= 40 &&
        (!('bio' in data) || (data.bio is string && data.bio.size() <= 500)) &&
        (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 500)) &&
        (!('bannerUrl' in data) || (data.bannerUrl is string && data.bannerUrl.size() <= 500)) &&
        data.isCreator is bool &&
        (!('isEarlyCreator' in data) || data.isEarlyCreator is bool) &&
        (!('isVerified' in data) || data.isVerified is bool) &&
        (!('isFeatured' in data) || data.isFeatured is bool) &&
        (!('boostEnabled' in data) || data.boostEnabled is bool) &&
        (!('leagueCategory' in data) || (data.leagueCategory is string && data.leagueCategory.size() <= 40)) &&
        (!('preferredLanguage' in data) || (data.preferredLanguage is string && data.preferredLanguage.size() <= 30)) &&
        (!('subscribersCount' in data) || (data.subscribersCount is number && data.subscribersCount >= 0)) &&
        (!('totalViews' in data) || (data.totalViews is number && data.totalViews >= 0)) &&
        (!('rewardTier' in data) || data.rewardTier in ['Seed', 'Rising', 'Star', 'Icon']) &&
        (!('accountStatus' in data) || data.accountStatus in ['active', 'suspended', 'deleted']) &&
        (!('channelStatus' in data) || data.channelStatus in ['active', 'suspended', 'deleted']) &&
        (!('moderationReason' in data) || (data.moderationReason is string && data.moderationReason.size() <= 500)) &&
        (!('statusUpdatedAt' in data) || data.statusUpdatedAt is timestamp) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPrivateAccount(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'updatedAt']) &&
        data.keys().hasOnly([
          'uid', 'email', 'role', 'monetizationEnabled', 'estimatedEarningsInr',
          'availableBalanceInr', 'pendingBalanceInr', 'lifetimeEarningsInr',
          'monetizationTermsAcceptedAt', 'upiId', 'notificationsEnabled', 'themePreference',
          'suspended', 'suspensionReason', 'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.role in ['viewer', 'creator', 'admin', 'ceo'] &&
        (!('monetizationEnabled' in data) || data.monetizationEnabled is bool) &&
        (!('estimatedEarningsInr' in data) || (data.estimatedEarningsInr is number && data.estimatedEarningsInr >= 0)) &&
        (!('availableBalanceInr' in data) || (data.availableBalanceInr is number && data.availableBalanceInr >= 0)) &&
        (!('pendingBalanceInr' in data) || (data.pendingBalanceInr is number && data.pendingBalanceInr >= 0)) &&
        (!('lifetimeEarningsInr' in data) || (data.lifetimeEarningsInr is number && data.lifetimeEarningsInr >= 0)) &&
        (!('monetizationTermsAcceptedAt' in data) || (data.monetizationTermsAcceptedAt is string && data.monetizationTermsAcceptedAt.size() <= 80)) &&
        (!('upiId' in data) || (data.upiId is string && data.upiId.size() <= 100)) &&
        (!('notificationsEnabled' in data) || data.notificationsEnabled is bool) &&
        (!('themePreference' in data) || data.themePreference in ['dark', 'light']) &&
        (!('suspended' in data) || data.suspended is bool) &&
        (!('suspensionReason' in data) || (data.suspensionReason is string && data.suspensionReason.size() <= 500)) &&
        data.updatedAt is timestamp;
    }

    function isValidAdminPermissions(perms) {
      return perms is map &&
        perms.keys().hasAll(['moderateVideos', 'resolveReports', 'manageCreators', 'manageCompetitions', 'manageAnnouncements', 'manageCategories']) &&
        perms.keys().hasOnly(['moderateVideos', 'resolveReports', 'manageCreators', 'manageCompetitions', 'manageAnnouncements', 'manageCategories', 'manageMonetization']) &&
        perms.moderateVideos is bool &&
        perms.resolveReports is bool &&
        perms.manageCreators is bool &&
        perms.manageCompetitions is bool &&
        perms.manageAnnouncements is bool &&
        perms.manageCategories is bool &&
        (!('manageMonetization' in perms) || perms.manageMonetization is bool);
    }

    function isValidAdminRole(data) {
      return data.keys().hasAll(['uid', 'permissions', 'grantedBy', 'grantedAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'email', 'permissions', 'grantedBy', 'notes', 'grantedAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 80)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 160)) &&
        isValidAdminPermissions(data.permissions) &&
        isValidId(data.grantedBy) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 300)) &&
        data.grantedAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCeoRole(data) {
      return data.keys().hasAll(['uid', 'clearanceLevel', 'grantedAt']) &&
        data.keys().hasOnly(['uid', 'clearanceLevel', 'grantedAt']) &&
        isValidId(data.uid) &&
        data.clearanceLevel == 'CEO' &&
        data.grantedAt is timestamp;
    }

    function isValidCeoAuditLog(data) {
      return data.keys().hasAll(['actorUid', 'action', 'targetType', 'targetId', 'reason', 'status', 'createdAt']) &&
        data.keys().hasOnly([
          'actorUid', 'actorEmail', 'actorRole', 'action', 'targetType', 'targetId',
          'targetLabel', 'reason', 'status', 'details', 'createdAt'
        ]) &&
        isValidId(data.actorUid) &&
        (!('actorEmail' in data) || (data.actorEmail is string && data.actorEmail.size() <= 160)) &&
        (!('actorRole' in data) || data.actorRole in ['ceo', 'admin']) &&
        data.action is string && data.action.size() >= 2 && data.action.size() <= 80 &&
        data.targetType in ['user', 'channel', 'video', 'report', 'announcement', 'system', 'admin', 'payout', 'config', 'competition', 'challenge', 'monetization', 'dispute', 'traffic', 'brand', 'payment'] &&
        isValidId(data.targetId) &&
        (!('targetLabel' in data) || (data.targetLabel is string && data.targetLabel.size() <= 150)) &&
        data.reason is string && data.reason.size() >= 2 && data.reason.size() <= 500 &&
        data.status in ['success', 'blocked', 'failed'] &&
        (!('details' in data) || (data.details is string && data.details.size() <= 500)) &&
        data.createdAt is timestamp;
    }

    function isValidCreatorPayout(data) {
      return data.keys().hasAll(['creatorId', 'creatorName', 'upiId', 'amountInr', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'creatorId', 'creatorName', 'creatorHandle', 'upiId', 'amountInr',
          'periodLabel', 'status', 'notes', 'processedByUid', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.creatorId) &&
        data.creatorName is string && data.creatorName.size() >= 1 && data.creatorName.size() <= 80 &&
        (!('creatorHandle' in data) || (data.creatorHandle is string && data.creatorHandle.size() <= 40)) &&
        data.upiId is string && data.upiId.size() >= 3 && data.upiId.size() <= 100 &&
        data.amountInr is number && data.amountInr >= 100 && data.amountInr <= 5000000 &&
        (!('periodLabel' in data) || (data.periodLabel is string && data.periodLabel.size() <= 60)) &&
        data.status in ['pending', 'approved', 'paid', 'rejected'] &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 300)) &&
        (!('processedByUid' in data) || (data.processedByUid is string && data.processedByUid.size() <= 128)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidVideo(data) {
      return data.keys().hasAll(['creatorId', 'creatorName', 'title', 'videoUrl', 'type', 'category', 'language', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'creatorId', 'creatorName', 'creatorAvatar', 'title', 'description',
          'videoUrl', 'thumbnailUrl', 'type', 'category', 'language',
          'durationSeconds', 'musicTrack', 'challengeId', 'tags', 'chapters',
          'accessType', 'priceInr', 'adsEnabled', 'adEligibility',
          'viewsCount', 'uniqueViewersCount', 'totalWatchSeconds', 'likesCount',
          'dislikesCount', 'commentsCount', 'sharesCount',
          'status', 'removalReason', 'removedBy',
          'isTrending', 'isEarlyCreatorSpotlight', 'isOriginal',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.creatorId) &&
        data.creatorName is string && data.creatorName.size() >= 1 && data.creatorName.size() <= 80 &&
        (!('creatorAvatar' in data) || (data.creatorAvatar is string && data.creatorAvatar.size() <= 500)) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 150 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 3000)) &&
        data.videoUrl is string && data.videoUrl.size() >= 1 && data.videoUrl.size() <= 500 &&
        (!('thumbnailUrl' in data) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 500)) &&
        data.type in ['video', 'short'] &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 50 &&
        data.language is string && data.language.size() >= 1 && data.language.size() <= 30 &&
        (!('durationSeconds' in data) || (data.durationSeconds is number && data.durationSeconds >= 0 && data.durationSeconds <= 86400)) &&
        (!('musicTrack' in data) || (data.musicTrack is string && data.musicTrack.size() <= 120)) &&
        (!('challengeId' in data) || (data.challengeId is string && data.challengeId.size() <= 128)) &&
        (!('tags' in data) || (data.tags is list && data.tags.size() <= 10 && (data.tags.size() == 0 || data.tags[0] is string))) &&
        (!('chapters' in data) || (data.chapters is list && data.chapters.size() <= 25 && (data.chapters.size() == 0 || data.chapters[0] is map))) &&
        (!('accessType' in data) || data.accessType in ['free', 'members_only', 'paid']) &&
        (!('priceInr' in data) || (data.priceInr is number && data.priceInr >= 0 && data.priceInr <= 50000)) &&
        (!('adsEnabled' in data) || data.adsEnabled is bool) &&
        (!('adEligibility' in data) || data.adEligibility in ['eligible', 'limited', 'ineligible']) &&
        (!('viewsCount' in data) || (data.viewsCount is number && data.viewsCount >= 0)) &&
        (!('uniqueViewersCount' in data) || (data.uniqueViewersCount is number && data.uniqueViewersCount >= 0)) &&
        (!('totalWatchSeconds' in data) || (data.totalWatchSeconds is number && data.totalWatchSeconds >= 0)) &&
        (!('likesCount' in data) || (data.likesCount is number && data.likesCount >= 0)) &&
        (!('dislikesCount' in data) || (data.dislikesCount is number && data.dislikesCount >= 0)) &&
        (!('commentsCount' in data) || (data.commentsCount is number && data.commentsCount >= 0)) &&
        (!('sharesCount' in data) || (data.sharesCount is number && data.sharesCount >= 0)) &&
        data.status in ['published', 'flagged', 'removed'] &&
        (!('removalReason' in data) || (data.removalReason is string && data.removalReason.size() <= 500)) &&
        (!('removedBy' in data) || (data.removedBy is string && data.removedBy.size() <= 128)) &&
        (!('isTrending' in data) || data.isTrending is bool) &&
        (!('isEarlyCreatorSpotlight' in data) || data.isEarlyCreatorSpotlight is bool) &&
        (!('isOriginal' in data) || data.isOriginal is bool) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidComment(data) {
      return data.keys().hasAll(['videoId', 'authorId', 'authorName', 'text', 'createdAt']) &&
        data.keys().hasOnly(['videoId', 'authorId', 'authorName', 'authorAvatar', 'text', 'parentCommentId', 'likesCount', 'createdAt']) &&
        isValidId(data.videoId) &&
        isValidId(data.authorId) &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
        (!('authorAvatar' in data) || (data.authorAvatar is string && data.authorAvatar.size() <= 500)) &&
        data.text is string && data.text.size() >= 1 && data.text.size() <= 1000 &&
        (!('parentCommentId' in data) || (data.parentCommentId is string && data.parentCommentId.size() <= 128)) &&
        (!('likesCount' in data) || (data.likesCount is number && data.likesCount >= 0)) &&
        data.createdAt is timestamp;
    }

    function isValidReaction(data) {
      return data.keys().hasAll(['videoId', 'userId', 'type', 'createdAt']) &&
        data.keys().hasOnly(['videoId', 'userId', 'type', 'createdAt']) &&
        isValidId(data.videoId) &&
        isValidId(data.userId) &&
        data.type in ['like', 'dislike'] &&
        data.createdAt is timestamp;
    }

    function isValidSubscription(data) {
      return data.keys().hasAll(['subscriberId', 'creatorId', 'createdAt']) &&
        data.keys().hasOnly(['subscriberId', 'creatorId', 'creatorName', 'creatorAvatar', 'createdAt']) &&
        isValidId(data.subscriberId) &&
        isValidId(data.creatorId) &&
        (!('creatorName' in data) || (data.creatorName is string && data.creatorName.size() <= 80)) &&
        (!('creatorAvatar' in data) || (data.creatorAvatar is string && data.creatorAvatar.size() <= 500)) &&
        data.createdAt is timestamp;
    }

    function isValidPlaylist(data) {
      return data.keys().hasAll(['ownerId', 'title', 'visibility', 'videoIds', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'ownerName', 'title', 'description', 'visibility', 'videoIds', 'thumbnailUrl', 'createdAt', 'updatedAt']) &&
        isValidId(data.ownerId) &&
        (!('ownerName' in data) || (data.ownerName is string && data.ownerName.size() <= 80)) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
        data.visibility in ['public', 'private'] &&
        data.videoIds is list && data.videoIds.size() <= 50 &&
        (data.videoIds.size() == 0 || data.videoIds[0] is string) &&
        (!('thumbnailUrl' in data) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 500)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidWatchHistory(data) {
      return data.keys().hasAll(['userId', 'videoId', 'title', 'progressSeconds', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'videoId', 'title', 'thumbnailUrl', 'creatorName', 'durationSeconds', 'progressSeconds', 'maxProgressSeconds', 'updatedAt']) &&
        isValidId(data.userId) &&
        isValidId(data.videoId) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
        (!('thumbnailUrl' in data) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 500)) &&
        (!('creatorName' in data) || (data.creatorName is string && data.creatorName.size() <= 80)) &&
        (!('durationSeconds' in data) || (data.durationSeconds is number && data.durationSeconds >= 0)) &&
        data.progressSeconds is number && data.progressSeconds >= 0 &&
        (!('maxProgressSeconds' in data) || (data.maxProgressSeconds is number && data.maxProgressSeconds >= 0)) &&
        data.updatedAt is timestamp;
    }

    function isValidWatchLater(data) {
      return data.keys().hasAll(['userId', 'videoId', 'title', 'createdAt']) &&
        data.keys().hasOnly(['userId', 'videoId', 'title', 'thumbnailUrl', 'creatorId', 'creatorName', 'durationSeconds', 'type', 'createdAt']) &&
        isValidId(data.userId) &&
        isValidId(data.videoId) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
        (!('thumbnailUrl' in data) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 500)) &&
        (!('creatorId' in data) || isValidId(data.creatorId)) &&
        (!('creatorName' in data) || (data.creatorName is string && data.creatorName.size() <= 80)) &&
        (!('durationSeconds' in data) || (data.durationSeconds is number && data.durationSeconds >= 0)) &&
        (!('type' in data) || data.type in ['video', 'short']) &&
        data.createdAt is timestamp;
    }

    function isValidCommunityPost(data) {
      return data.keys().hasAll(['creatorId', 'creatorName', 'content', 'postType', 'createdAt']) &&
        data.keys().hasOnly(['creatorId', 'creatorName', 'creatorAvatar', 'content', 'imageUrl', 'postType', 'pollOptions', 'pollVotes', 'likesCount', 'createdAt']) &&
        isValidId(data.creatorId) &&
        data.creatorName is string && data.creatorName.size() >= 1 && data.creatorName.size() <= 80 &&
        (!('creatorAvatar' in data) || (data.creatorAvatar is string && data.creatorAvatar.size() <= 500)) &&
        data.content is string && data.content.size() >= 1 && data.content.size() <= 1500 &&
        (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 500)) &&
        data.postType in ['text', 'image', 'poll', 'announcement'] &&
        (!('pollOptions' in data) || (data.pollOptions is list && data.pollOptions.size() <= 4 && (data.pollOptions.size() == 0 || data.pollOptions[0] is string))) &&
        (!('pollVotes' in data) || (data.pollVotes is list && data.pollVotes.size() <= 4 && (data.pollVotes.size() == 0 || data.pollVotes[0] is number))) &&
        (!('likesCount' in data) || (data.likesCount is number && data.likesCount >= 0)) &&
        data.createdAt is timestamp;
    }

    function isValidCreatorSupport(data) {
      return data.keys().hasAll(['supporterId', 'creatorId', 'amountInr', 'createdAt']) &&
        data.keys().hasOnly(['supporterId', 'supporterName', 'creatorId', 'creatorName', 'amountInr', 'message', 'paymentOrderId', 'paymentVerified', 'status', 'createdAt']) &&
        isValidId(data.supporterId) &&
        (!('supporterName' in data) || (data.supporterName is string && data.supporterName.size() <= 80)) &&
        isValidId(data.creatorId) &&
        (!('creatorName' in data) || (data.creatorName is string && data.creatorName.size() <= 80)) &&
        data.amountInr is number && data.amountInr >= 10 && data.amountInr <= 50000 &&
        (!('message' in data) || (data.message is string && data.message.size() <= 280)) &&
        (!('paymentOrderId' in data) || (data.paymentOrderId is string && data.paymentOrderId.size() <= 128)) &&
        (!('paymentVerified' in data) || data.paymentVerified is bool) &&
        (!('status' in data) || data.status in ['pending_verification', 'verified', 'rejected', 'refunded']) &&
        data.createdAt is timestamp;
    }

    function isValidCollaboration(data) {
      return data.keys().hasAll(['senderId', 'senderName', 'recipientId', 'recipientName', 'title', 'proposal', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['senderId', 'senderName', 'senderAvatar', 'recipientId', 'recipientName', 'recipientAvatar', 'title', 'proposal', 'status', 'createdAt', 'updatedAt']) &&
        isValidId(data.senderId) &&
        data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80 &&
        (!('senderAvatar' in data) || (data.senderAvatar is string && data.senderAvatar.size() <= 500)) &&
        isValidId(data.recipientId) &&
        data.recipientName is string && data.recipientName.size() >= 1 && data.recipientName.size() <= 80 &&
        (!('recipientAvatar' in data) || (data.recipientAvatar is string && data.recipientAvatar.size() <= 500)) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
        data.proposal is string && data.proposal.size() >= 5 && data.proposal.size() <= 800 &&
        data.status in ['pending', 'accepted', 'rejected'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidWatchParty(data) {
      return data.keys().hasAll(['hostId', 'hostName', 'title', 'videoId', 'videoTitle', 'videoUrl', 'inviteCode', 'isPrivate', 'isPlaying', 'currentTimeSeconds', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['hostId', 'hostName', 'title', 'videoId', 'videoTitle', 'videoUrl', 'thumbnailUrl', 'inviteCode', 'isPrivate', 'isPlaying', 'currentTimeSeconds', 'status', 'createdAt', 'updatedAt']) &&
        isValidId(data.hostId) &&
        data.hostName is string && data.hostName.size() >= 1 && data.hostName.size() <= 80 &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
        isValidId(data.videoId) &&
        data.videoTitle is string && data.videoTitle.size() >= 1 && data.videoTitle.size() <= 150 &&
        data.videoUrl is string && data.videoUrl.size() >= 1 && data.videoUrl.size() <= 500 &&
        (!('thumbnailUrl' in data) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 500)) &&
        data.inviteCode is string && data.inviteCode.size() >= 4 && data.inviteCode.size() <= 32 &&
        data.isPrivate is bool &&
        data.isPlaying is bool &&
        data.currentTimeSeconds is number && data.currentTimeSeconds >= 0 &&
        data.status in ['active', 'ended'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidWatchPartyMessage(data) {
      return data.keys().hasAll(['roomId', 'senderId', 'senderName', 'text', 'createdAt']) &&
        data.keys().hasOnly(['roomId', 'senderId', 'senderName', 'senderAvatar', 'text', 'createdAt']) &&
        isValidId(data.roomId) &&
        isValidId(data.senderId) &&
        data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80 &&
        (!('senderAvatar' in data) || (data.senderAvatar is string && data.senderAvatar.size() <= 500)) &&
        data.text is string && data.text.size() >= 1 && data.text.size() <= 400 &&
        data.createdAt is timestamp;
    }

    function isValidLiveStream(data) {
      return data.keys().hasAll(['creatorId', 'creatorName', 'title', 'isLive', 'startedAt']) &&
        data.keys().hasOnly(['creatorId', 'creatorName', 'creatorAvatar', 'title', 'description', 'category', 'language', 'thumbnailUrl', 'streamUrl', 'isLive', 'viewerCount', 'startedAt']) &&
        isValidId(data.creatorId) &&
        data.creatorName is string && data.creatorName.size() >= 1 && data.creatorName.size() <= 80 &&
        (!('creatorAvatar' in data) || (data.creatorAvatar is string && data.creatorAvatar.size() <= 500)) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 150 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
        (!('category' in data) || (data.category is string && data.category.size() <= 50)) &&
        (!('language' in data) || (data.language is string && data.language.size() <= 30)) &&
        (!('thumbnailUrl' in data) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 500)) &&
        (!('streamUrl' in data) || (data.streamUrl is string && data.streamUrl.size() <= 500)) &&
        data.isLive is bool &&
        (!('viewerCount' in data) || (data.viewerCount is number && data.viewerCount >= 0)) &&
        data.startedAt is timestamp;
    }

    function isValidLiveChatMessage(data) {
      return data.keys().hasAll(['streamId', 'senderId', 'senderName', 'text', 'createdAt']) &&
        data.keys().hasOnly(['streamId', 'senderId', 'senderName', 'senderAvatar', 'text', 'superSupportInr', 'createdAt']) &&
        isValidId(data.streamId) &&
        isValidId(data.senderId) &&
        data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80 &&
        (!('senderAvatar' in data) || (data.senderAvatar is string && data.senderAvatar.size() <= 500)) &&
        data.text is string && data.text.size() >= 1 && data.text.size() <= 400 &&
        (!('superSupportInr' in data) || (data.superSupportInr is number && data.superSupportInr >= 0 && data.superSupportInr <= 50000)) &&
        data.createdAt is timestamp;
    }

    function isValidChallenge(data) {
      return data.keys().hasAll(['title', 'description', 'prizePoolInr', 'status', 'createdAt']) &&
        data.keys().hasOnly(['title', 'description', 'prizePoolInr', 'category', 'deadline', 'participantsCount', 'status', 'createdAt']) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
        data.description is string && data.description.size() >= 5 && data.description.size() <= 1000 &&
        data.prizePoolInr is number && data.prizePoolInr >= 0 &&
        (!('category' in data) || (data.category is string && data.category.size() <= 50)) &&
        (!('deadline' in data) || (data.deadline is string && data.deadline.size() <= 40)) &&
        (!('participantsCount' in data) || (data.participantsCount is number && data.participantsCount >= 0)) &&
        data.status in ['active', 'ended'] &&
        data.createdAt is timestamp;
    }

    function isValidCompetition(data) {
      return data.keys().hasAll(['title', 'monthLabel', 'description', 'prizePoolInr', 'status', 'createdAt']) &&
        data.keys().hasOnly(['title', 'monthLabel', 'description', 'prizePoolInr', 'categories', 'winnerCreatorId', 'winnerCreatorName', 'status', 'createdAt']) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
        data.monthLabel is string && data.monthLabel.size() >= 2 && data.monthLabel.size() <= 40 &&
        data.description is string && data.description.size() >= 5 && data.description.size() <= 1000 &&
        data.prizePoolInr is number && data.prizePoolInr >= 0 &&
        (!('categories' in data) || (data.categories is list && data.categories.size() <= 10 && (data.categories.size() == 0 || data.categories[0] is string))) &&
        (!('winnerCreatorId' in data) || (data.winnerCreatorId is string && data.winnerCreatorId.size() <= 128)) &&
        (!('winnerCreatorName' in data) || (data.winnerCreatorName is string && data.winnerCreatorName.size() <= 80)) &&
        data.status in ['active', 'completed'] &&
        data.createdAt is timestamp;
    }

    function isValidAnnouncement(data) {
      return data.keys().hasAll(['title', 'body', 'category', 'isActive', 'createdAt']) &&
        data.keys().hasOnly(['title', 'body', 'category', 'createdBy', 'isActive', 'createdAt']) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
        data.body is string && data.body.size() >= 3 && data.body.size() <= 600 &&
        data.category in ['feature', 'league', 'policy', 'event'] &&
        (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 80)) &&
        data.isActive is bool &&
        data.createdAt is timestamp;
    }

    function isValidReport(data) {
      return data.keys().hasAll(['reporterId', 'targetType', 'targetId', 'reason', 'status', 'createdAt']) &&
        data.keys().hasOnly(['reporterId', 'targetType', 'targetId', 'targetTitle', 'reason', 'status', 'createdAt']) &&
        isValidId(data.reporterId) &&
        data.targetType in ['video', 'comment', 'user'] &&
        isValidId(data.targetId) &&
        (!('targetTitle' in data) || (data.targetTitle is string && data.targetTitle.size() <= 150)) &&
        data.reason is string && data.reason.size() >= 3 && data.reason.size() <= 500 &&
        data.status in ['pending', 'reviewed', 'resolved', 'dismissed'] &&
        data.createdAt is timestamp;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['recipientId', 'type', 'title', 'message', 'isRead', 'createdAt']) &&
        data.keys().hasOnly(['recipientId', 'senderName', 'type', 'title', 'message', 'linkPath', 'isRead', 'createdAt']) &&
        isValidId(data.recipientId) &&
        (!('senderName' in data) || (data.senderName is string && data.senderName.size() <= 80)) &&
        data.type in ['live', 'upload', 'comment', 'support', 'reward', 'system', 'subscriber', 'like', 'collaboration', 'announcement'] &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 300 &&
        (!('linkPath' in data) || (data.linkPath is string && data.linkPath.size() <= 200)) &&
        data.isRead is bool &&
        data.createdAt is timestamp;
    }

    function isValidPlatformConfig(data) {
      return data.keys().hasAll(['categories', 'languages', 'earlyCreatorBoostEnabled', 'creatorRevenueSharePercent', 'updatedAt']) &&
        data.keys().hasOnly([
          'categories', 'languages', 'earlyCreatorBoostEnabled', 'creatorRevenueSharePercent',
          'adSharePercent', 'membershipSharePercent', 'supportSharePercent', 'paidVideoSharePercent',
          'paymentGatewayMode', 'minPayoutInr', 'maintenanceMode', 'updatedAt'
        ]) &&
        data.categories is list && data.categories.size() <= 20 && (data.categories.size() == 0 || data.categories[0] is string) &&
        data.languages is list && data.languages.size() <= 20 && (data.languages.size() == 0 || data.languages[0] is string) &&
        data.earlyCreatorBoostEnabled is bool &&
        data.creatorRevenueSharePercent is number && data.creatorRevenueSharePercent >= 0 && data.creatorRevenueSharePercent <= 100 &&
        (!('adSharePercent' in data) || (data.adSharePercent is number && data.adSharePercent >= 0 && data.adSharePercent <= 100)) &&
        (!('membershipSharePercent' in data) || (data.membershipSharePercent is number && data.membershipSharePercent >= 0 && data.membershipSharePercent <= 100)) &&
        (!('supportSharePercent' in data) || (data.supportSharePercent is number && data.supportSharePercent >= 0 && data.supportSharePercent <= 100)) &&
        (!('paidVideoSharePercent' in data) || (data.paidVideoSharePercent is number && data.paidVideoSharePercent >= 0 && data.paidVideoSharePercent <= 100)) &&
        (!('paymentGatewayMode' in data) || data.paymentGatewayMode in ['unconfigured', 'test', 'live']) &&
        (!('minPayoutInr' in data) || (data.minPayoutInr is number && data.minPayoutInr >= 100 && data.minPayoutInr <= 50000)) &&
        (!('maintenanceMode' in data) || data.maintenanceMode is bool) &&
        data.updatedAt is timestamp;
    }

    // --- Monetization Validation Blueprints ---
    function isValidAdRevenueRecord(data) {
      return data.keys().hasAll(['videoId', 'videoTitle', 'creatorId', 'creatorName', 'periodLabel', 'validImpressions', 'invalidImpressionsBlocked', 'grossAdRevenueInr', 'creatorSharePercent', 'creatorNetInr', 'status', 'createdAt']) &&
        data.keys().hasOnly(['videoId', 'videoTitle', 'creatorId', 'creatorName', 'periodLabel', 'validImpressions', 'invalidImpressionsBlocked', 'grossAdRevenueInr', 'creatorSharePercent', 'creatorNetInr', 'status', 'notes', 'createdAt']) &&
        isValidId(data.videoId) &&
        data.videoTitle is string && data.videoTitle.size() >= 1 && data.videoTitle.size() <= 150 &&
        isValidId(data.creatorId) &&
        data.creatorName is string && data.creatorName.size() >= 1 && data.creatorName.size() <= 80 &&
        data.periodLabel is string && data.periodLabel.size() >= 1 && data.periodLabel.size() <= 60 &&
        data.validImpressions is number && data.validImpressions >= 0 &&
        data.invalidImpressionsBlocked is number && data.invalidImpressionsBlocked >= 0 &&
        data.grossAdRevenueInr is number && data.grossAdRevenueInr >= 0 &&
        data.creatorSharePercent is number && data.creatorSharePercent >= 0 && data.creatorSharePercent <= 100 &&
        data.creatorNetInr is number && data.creatorNetInr >= 0 &&
        data.status in ['pending', 'verified', 'invalidated'] &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 300)) &&
        data.createdAt is timestamp;
    }

    function isValidMembershipPlan(data) {
      return data.keys().hasAll(['creatorId', 'creatorName', 'name', 'tierLevel', 'priceInr', 'perks', 'isActive', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['creatorId', 'creatorName', 'name', 'tierLevel', 'priceInr', 'perks', 'isActive', 'createdAt', 'updatedAt']) &&
        isValidId(data.creatorId) &&
        data.creatorName is string && data.creatorName.size() >= 1 && data.creatorName.size() <= 80 &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 60 &&
        data.tierLevel is number && data.tierLevel >= 1 && data.tierLevel <= 10 &&
        data.priceInr is number && data.priceInr >= 29 && data.priceInr <= 50000 &&
        data.perks is string && data.perks.size() >= 4 && data.perks.size() <= 400 &&
        data.isActive is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCreatorMembership(data) {
      return data.keys().hasAll(['planId', 'planName', 'creatorId', 'creatorName', 'memberId', 'memberName', 'priceInr', 'status', 'paymentVerified', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['planId', 'planName', 'creatorId', 'creatorName', 'memberId', 'memberName', 'priceInr', 'status', 'paymentOrderId', 'paymentVerified', 'renewsAt', 'createdAt', 'updatedAt']) &&
        isValidId(data.planId) &&
        data.planName is string && data.planName.size() >= 1 && data.planName.size() <= 60 &&
        isValidId(data.creatorId) &&
        data.creatorName is string && data.creatorName.size() >= 1 && data.creatorName.size() <= 80 &&
        isValidId(data.memberId) &&
        data.memberName is string && data.memberName.size() >= 1 && data.memberName.size() <= 80 &&
        data.priceInr is number && data.priceInr >= 29 && data.priceInr <= 50000 &&
        data.status in ['pending', 'active', 'cancelled', 'expired', 'rejected'] &&
        (!('paymentOrderId' in data) || (data.paymentOrderId is string && data.paymentOrderId.size() <= 128)) &&
        data.paymentVerified is bool &&
        (!('renewsAt' in data) || (data.renewsAt is string && data.renewsAt.size() <= 60)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidBrandCampaign(data) {
      return data.keys().hasAll(['brandName', 'brandId', 'title', 'description', 'budgetInr', 'category', 'deliverables', 'deadline', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['brandName', 'brandId', 'title', 'description', 'budgetInr', 'category', 'deliverables', 'deadline', 'status', 'createdAt', 'updatedAt']) &&
        data.brandName is string && data.brandName.size() >= 2 && data.brandName.size() <= 80 &&
        isValidId(data.brandId) &&
        data.title is string && data.title.size() >= 3 && data.title.size() <= 120 &&
        data.description is string && data.description.size() >= 5 && data.description.size() <= 1000 &&
        data.budgetInr is number && data.budgetInr >= 500 && data.budgetInr <= 50000000 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 50 &&
        data.deliverables is string && data.deliverables.size() >= 2 && data.deliverables.size() <= 500 &&
        data.deadline is string && data.deadline.size() >= 2 && data.deadline.size() <= 40 &&
        data.status in ['open', 'in_progress', 'completed', 'closed'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidBrandApplication(data) {
      return data.keys().hasAll(['campaignId', 'campaignTitle', 'brandName', 'creatorId', 'creatorName', 'pitch', 'proposedFeeInr', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['campaignId', 'campaignTitle', 'brandName', 'creatorId', 'creatorName', 'pitch', 'proposedFeeInr', 'status', 'deliverableUrl', 'reviewNotes', 'createdAt', 'updatedAt']) &&
        isValidId(data.campaignId) &&
        data.campaignTitle is string && data.campaignTitle.size() >= 1 && data.campaignTitle.size() <= 120 &&
        data.brandName is string && data.brandName.size() >= 1 && data.brandName.size() <= 80 &&
        isValidId(data.creatorId) &&
        data.creatorName is string && data.creatorName.size() >= 1 && data.creatorName.size() <= 80 &&
        data.pitch is string && data.pitch.size() >= 5 && data.pitch.size() <= 800 &&
        data.proposedFeeInr is number && data.proposedFeeInr >= 100 && data.proposedFeeInr <= 50000000 &&
        data.status in ['applied', 'shortlisted', 'approved', 'delivered', 'paid', 'rejected'] &&
        (!('deliverableUrl' in data) || (data.deliverableUrl is string && data.deliverableUrl.size() <= 500)) &&
        (!('reviewNotes' in data) || (data.reviewNotes is string && data.reviewNotes.size() <= 300)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAffiliateLink(data) {
      return data.keys().hasAll(['creatorId', 'creatorName', 'code', 'targetUrl', 'productTitle', 'merchantName', 'commissionPercent', 'clicksCount', 'validClicksCount', 'conversionsCount', 'earnedInr', 'isActive', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['creatorId', 'creatorName', 'code', 'targetUrl', 'productTitle', 'merchantName', 'commissionPercent', 'clicksCount', 'validClicksCount', 'conversionsCount', 'earnedInr', 'isActive', 'createdAt', 'updatedAt']) &&
        isValidId(data.creatorId) &&
        data.creatorName is string && data.creatorName.size() >= 1 && data.creatorName.size() <= 80 &&
        data.code is string && data.code.size() >= 4 && data.code.size() <= 32 &&
        data.targetUrl is string && data.targetUrl.size() >= 8 && data.targetUrl.size() <= 500 &&
        data.productTitle is string && data.productTitle.size() >= 2 && data.productTitle.size() <= 120 &&
        data.merchantName is string && data.merchantName.size() >= 2 && data.merchantName.size() <= 80 &&
        data.commissionPercent is number && data.commissionPercent >= 1 && data.commissionPercent <= 50 &&
        data.clicksCount is number && data.clicksCount >= 0 &&
        data.validClicksCount is number && data.validClicksCount >= 0 &&
        data.conversionsCount is number && data.conversionsCount >= 0 &&
        data.earnedInr is number && data.earnedInr >= 0 &&
        data.isActive is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAffiliateEvent(data) {
      return data.keys().hasAll(['linkId', 'code', 'creatorId', 'eventType', 'saleAmountInr', 'commissionInr', 'isInvalidTraffic', 'status', 'createdAt']) &&
        data.keys().hasOnly(['linkId', 'code', 'creatorId', 'eventType', 'orderRef', 'saleAmountInr', 'commissionInr', 'isInvalidTraffic', 'status', 'createdAt']) &&
        isValidId(data.linkId) &&
        data.code is string && data.code.size() >= 4 && data.code.size() <= 32 &&
        isValidId(data.creatorId) &&
        data.eventType in ['click', 'conversion'] &&
        (!('orderRef' in data) || (data.orderRef is string && data.orderRef.size() <= 128)) &&
        data.saleAmountInr is number && data.saleAmountInr >= 0 &&
        data.commissionInr is number && data.commissionInr >= 0 &&
        data.isInvalidTraffic is bool &&
        data.status in ['recorded', 'pending', 'verified', 'rejected'] &&
        data.createdAt is timestamp;
    }

    function isValidVideoPurchase(data) {
      return data.keys().hasAll(['videoId', 'videoTitle', 'creatorId', 'creatorName', 'buyerId', 'buyerName', 'amountInr', 'creatorNetInr', 'platformFeeInr', 'paymentVerified', 'status', 'createdAt']) &&
        data.keys().hasOnly(['videoId', 'videoTitle', 'creatorId', 'creatorName', 'buyerId', 'buyerName', 'amountInr', 'creatorNetInr', 'platformFeeInr', 'paymentOrderId', 'paymentVerified', 'status', 'createdAt']) &&
        isValidId(data.videoId) &&
        data.videoTitle is string && data.videoTitle.size() >= 1 && data.videoTitle.size() <= 150 &&
        isValidId(data.creatorId) &&
        data.creatorName is string && data.creatorName.size() >= 1 && data.creatorName.size() <= 80 &&
        isValidId(data.buyerId) &&
        data.buyerName is string && data.buyerName.size() >= 1 && data.buyerName.size() <= 80 &&
        data.amountInr is number && data.amountInr >= 10 && data.amountInr <= 50000 &&
        data.creatorNetInr is number && data.creatorNetInr >= 0 &&
        data.platformFeeInr is number && data.platformFeeInr >= 0 &&
        (!('paymentOrderId' in data) || (data.paymentOrderId is string && data.paymentOrderId.size() <= 128)) &&
        data.paymentVerified is bool &&
        data.status in ['pending_verification', 'verified', 'rejected', 'refunded', 'disputed'] &&
        data.createdAt is timestamp;
    }

    function isValidMonetizationTransaction(data) {
      return data.keys().hasAll(['creatorId', 'source', 'grossInr', 'platformFeeInr', 'netCreatorInr', 'status', 'gatewayVerified', 'description', 'createdAt']) &&
        data.keys().hasOnly(['creatorId', 'counterpartyId', 'counterpartyName', 'source', 'grossInr', 'platformFeeInr', 'netCreatorInr', 'status', 'referenceId', 'gatewayVerified', 'description', 'createdAt']) &&
        isValidId(data.creatorId) &&
        (!('counterpartyId' in data) || (data.counterpartyId is string && data.counterpartyId.size() <= 128)) &&
        (!('counterpartyName' in data) || (data.counterpartyName is string && data.counterpartyName.size() <= 80)) &&
        data.source in ['ad_revenue', 'membership', 'support', 'brand_connect', 'affiliate', 'paid_video', 'payout', 'adjustment'] &&
        data.grossInr is number &&
        data.platformFeeInr is number &&
        data.netCreatorInr is number &&
        data.status in ['pending', 'settled', 'held', 'disputed', 'reversed', 'paid'] &&
        (!('referenceId' in data) || (data.referenceId is string && data.referenceId.size() <= 128)) &&
        data.gatewayVerified is bool &&
        data.description is string && data.description.size() >= 2 && data.description.size() <= 300 &&
        data.createdAt is timestamp;
    }

    function isValidInvalidTrafficFlag(data) {
      return data.keys().hasAll(['targetType', 'targetId', 'creatorId', 'creatorName', 'signalType', 'suspiciousCount', 'estimatedImpactInr', 'severity', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['targetType', 'targetId', 'creatorId', 'creatorName', 'signalType', 'suspiciousCount', 'estimatedImpactInr', 'severity', 'status', 'notes', 'createdAt', 'updatedAt']) &&
        data.targetType in ['video', 'affiliate', 'creator'] &&
        isValidId(data.targetId) &&
        isValidId(data.creatorId) &&
        data.creatorName is string && data.creatorName.size() >= 1 && data.creatorName.size() <= 80 &&
        data.signalType is string && data.signalType.size() >= 2 && data.signalType.size() <= 120 &&
        data.suspiciousCount is number && data.suspiciousCount >= 0 &&
        data.estimatedImpactInr is number && data.estimatedImpactInr >= 0 &&
        data.severity in ['low', 'medium', 'high'] &&
        data.status in ['open', 'confirmed_invalid', 'cleared'] &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 400)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPaymentDispute(data) {
      return data.keys().hasAll(['reporterId', 'reporterName', 'creatorId', 'creatorName', 'transactionId', 'amountInr', 'category', 'reason', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['reporterId', 'reporterName', 'creatorId', 'creatorName', 'transactionId', 'amountInr', 'category', 'reason', 'status', 'resolutionNote', 'createdAt', 'updatedAt']) &&
        isValidId(data.reporterId) &&
        data.reporterName is string && data.reporterName.size() >= 1 && data.reporterName.size() <= 80 &&
        isValidId(data.creatorId) &&
        data.creatorName is string && data.creatorName.size() >= 1 && data.creatorName.size() <= 80 &&
        data.transactionId is string && data.transactionId.size() >= 1 && data.transactionId.size() <= 128 &&
        data.amountInr is number && data.amountInr >= 0 && data.amountInr <= 50000000 &&
        data.category in ['unauthorized', 'undelivered', 'payout_delay', 'ad_deduction', 'brand_milestone'] &&
        data.reason is string && data.reason.size() >= 5 && data.reason.size() <= 500 &&
        data.status in ['open', 'investigating', 'resolved', 'refunded', 'rejected'] &&
        (!('resolutionNote' in data) || (data.resolutionNote is string && data.resolutionNote.size() <= 400)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPaymentTransaction(data) {
      return data.keys().hasAll(['userId', 'userName', 'paymentMethod', 'amountInr', 'utrNumber', 'serviceType', 'targetId', 'targetTitle', 'creatorId', 'creatorName', 'status', 'serviceActivated', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'userId', 'userName', 'userEmail', 'paymentMethod', 'amountInr', 'utrNumber',
          'serviceType', 'targetId', 'targetTitle', 'creatorId', 'creatorName', 'serviceRecordId',
          'note', 'qrCodeImage', 'status', 'serviceActivated', 'rejectionReason',
          'verifiedByUid', 'verifiedByRole', 'verifiedAt', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.userId) &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 80 &&
        (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 160)) &&
        data.paymentMethod in ['PhonePe', 'Google Pay', 'Paytm', 'UPI', 'Other UPI Apps'] &&
        data.amountInr is number && data.amountInr >= 1 && data.amountInr <= 500000 &&
        data.utrNumber is string && data.utrNumber.size() >= 6 && data.utrNumber.size() <= 40 &&
        data.serviceType in ['paid_video', 'membership', 'support', 'creator_boost_pass', 'platform_service'] &&
        isValidId(data.targetId) &&
        data.targetTitle is string && data.targetTitle.size() >= 1 && data.targetTitle.size() <= 150 &&
        isValidId(data.creatorId) &&
        data.creatorName is string && data.creatorName.size() >= 1 && data.creatorName.size() <= 80 &&
        (!('serviceRecordId' in data) || (data.serviceRecordId is string && data.serviceRecordId.size() <= 128)) &&
        (!('note' in data) || (data.note is string && data.note.size() <= 280)) &&
        (!('qrCodeImage' in data) || (data.qrCodeImage is string && data.qrCodeImage.size() <= 200)) &&
        data.status in ['pending_verification', 'approved', 'rejected'] &&
        data.serviceActivated is bool &&
        (!('rejectionReason' in data) || (data.rejectionReason is string && data.rejectionReason.size() <= 300)) &&
        (!('verifiedByUid' in data) || (data.verifiedByUid is string && data.verifiedByUid.size() <= 128)) &&
        (!('verifiedByRole' in data) || data.verifiedByRole in ['ceo', 'admin']) &&
        (!('verifiedAt' in data) || (data.verifiedAt is string && data.verifiedAt.size() <= 60)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if resource.data.isCreator == true || isAdmin() || isCEO();
      allow create: if isValidId(userId) && isVerifiedUser() &&
        isValidPublicProfile(incoming()) &&
        (isCEO() || incoming().uid == request.auth.uid) &&
        incoming().uid == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (!('isVerified' in incoming()) || incoming().isVerified == false || isCEO()) &&
        (!('isFeatured' in incoming()) || incoming().isFeatured == false || isCEO()) &&
        (!('boostEnabled' in incoming()) || incoming().boostEnabled == false || isCEO()) &&
        (!('accountStatus' in incoming()) || incoming().accountStatus == 'active' || isCEO()) &&
        (!('channelStatus' in incoming()) || incoming().channelStatus == 'active' || isCEO());

      allow update: if isValidId(userId) && isVerifiedUser() && isValidPublicProfile(incoming()) && (
        isCEO() ||
        (
          hasAdminPerm('manageCreators') &&
          !isTargetCEO(userId) &&
          incoming().uid == existing().uid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['isVerified', 'isFeatured', 'boostEnabled', 'isEarlyCreator', 'leagueCategory', 'rewardTier', 'updatedAt'])
        ) ||
        (
          isOwner(userId) &&
          existing().accountStatus != 'suspended' &&
          existing().accountStatus != 'deleted' &&
          incoming().uid == existing().uid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'handle', 'bio', 'avatarUrl', 'bannerUrl', 'isCreator', 'isEarlyCreator', 'preferredLanguage', 'leagueCategory', 'updatedAt']) &&
          (incoming().isCreator == existing().isCreator || (existing().channelStatus != 'suspended' && existing().channelStatus != 'deleted'))
        ) ||
        (
          incoming().uid == existing().uid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['subscribersCount', 'updatedAt'])
        ) ||
        (
          incoming().uid == existing().uid &&
