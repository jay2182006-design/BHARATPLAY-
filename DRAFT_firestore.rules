rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isCEO() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/ceoRoles/$(request.auth.uid)) ||
        request.auth.token.email == 'jay2182006@gmail.com'
      );
    }

    function isAdmin() {
      return isCEO() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- Validation Blueprints ---
    function isValidPublicProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'handle', 'isCreator', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'uid', 'displayName', 'handle', 'bio', 'avatarUrl', 'bannerUrl',
          'isCreator', 'isEarlyCreator', 'isVerified', 'isFeatured', 'boostEnabled',
          'leagueCategory', 'preferredLanguage', 'subscribersCount', 'totalViews',
          'rewardTier', 'accountStatus', 'channelStatus', 'moderationReason',
          'statusUpdatedAt', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        data.handle is string && data.handle.size() >= 2 && data.handle.size() <= 40 &&
        (!('bio' in data) || (data.bio is string && data.bio.size() <= 500)) &&
        (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 500)) &&
        (!('bannerUrl' in data) || (data.bannerUrl is string && data.bannerUrl.size() <= 500)) &&
        data.isCreator is bool &&
        (!('isEarlyCreator' in data) || data.isEarlyCreator is bool) &&
        (!('isVerified' in data) || data.isVerified is bool) &&
        (!('isFeatured' in data) || data.isFeatured is bool) &&
        (!('boostEnabled' in data) || data.boostEnabled is bool) &&
        (!('leagueCategory' in data) || (data.leagueCategory is string && data.leagueCategory.size() <= 40)) &&
        (!('preferredLanguage' in data) || (data.preferredLanguage is string && data.preferredLanguage.size() <= 30)) &&
        (!('subscribersCount' in data) || (data.subscribersCount is number && data.subscribersCount >= 0)) &&
        (!('totalViews' in data) || (data.totalViews is number && data.totalViews >= 0)) &&
        (!('rewardTier' in data) || data.rewardTier in ['Seed', 'Rising', 'Star', 'Icon']) &&
        (!('accountStatus' in data) || data.accountStatus in ['active', 'suspended', 'deleted']) &&
        (!('channelStatus' in data) || data.channelStatus in ['active', 'suspended', 'deleted']) &&
        (!('moderationReason' in data) || (data.moderationReason is string && data.moderationReason.size() <= 500)) &&
        (!('statusUpdatedAt' in data) || data.statusUpdatedAt is timestamp) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPrivateAccount(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'updatedAt']) &&
        data.keys().hasOnly([
          'uid', 'email', 'role', 'monetizationEnabled', 'estimatedEarningsInr',
          'upiId', 'notificationsEnabled', 'suspended', 'suspensionReason', 'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.role in ['viewer', 'creator', 'admin', 'ceo'] &&
        (!('monetizationEnabled' in data) || data.monetizationEnabled is bool) &&
        (!('estimatedEarningsInr' in data) || (data.estimatedEarningsInr is number && data.estimatedEarningsInr >= 0)) &&
        (!('upiId' in data) || (data.upiId is string && data.upiId.size() <= 100)) &&
        (!('notificationsEnabled' in data) || data.notificationsEnabled is bool) &&
        (!('suspended' in data) || data.suspended is bool) &&
        (!('suspensionReason' in data) || (data.suspensionReason is string && data.suspensionReason.size() <= 500)) &&
        data.updatedAt is timestamp;
    }

    function isValidCeoRole(data) {
      return data.keys().hasAll(['uid', 'clearanceLevel', 'grantedAt']) &&
        data.keys().hasOnly(['uid', 'clearanceLevel', 'grantedAt']) &&
        isValidId(data.uid) &&
        data.clearanceLevel == 'CEO' &&
        data.grantedAt is timestamp;
    }

    function isValidCeoAuditLog(data) {
      return data.keys().hasAll(['actorUid', 'action', 'targetType', 'targetId', 'reason', 'status', 'createdAt']) &&
        data.keys().hasOnly([
          'actorUid', 'actorEmail', 'action', 'targetType', 'targetId',
          'targetLabel', 'reason', 'status', 'details', 'createdAt'
        ]) &&
        isValidId(data.actorUid) &&
        (!('actorEmail' in data) || (data.actorEmail is string && data.actorEmail.size() <= 160)) &&
        data.action is string && data.action.size() >= 2 && data.action.size() <= 80 &&
        data.targetType in ['user', 'channel', 'video', 'report', 'announcement', 'system'] &&
        isValidId(data.targetId) &&
        (!('targetLabel' in data) || (data.targetLabel is string && data.targetLabel.size() <= 150)) &&
        data.reason is string && data.reason.size() >= 2 && data.reason.size() <= 500 &&
        data.status in ['success', 'blocked', 'failed'] &&
        (!('details' in data) || (data.details is string && data.details.size() <= 500)) &&
        data.createdAt is timestamp;
    }

    function isValidVideo(data) {
      return data.keys().hasAll(['creatorId', 'creatorName', 'title', 'videoUrl', 'type', 'category', 'language', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'creatorId', 'creatorName', 'creatorAvatar', 'title', 'description',
          'videoUrl', 'thumbnailUrl', 'type', 'category', 'language',
          'durationSeconds', 'musicTrack', 'challengeId', 'tags', 'chapters',
          'viewsCount', 'uniqueViewersCount', 'totalWatchSeconds', 'likesCount',
          'dislikesCount', 'commentsCount', 'sharesCount',
          'status', 'removalReason', 'removedBy',
          'isTrending', 'isEarlyCreatorSpotlight', 'isOriginal',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.creatorId) &&
        data.creatorName is string && data.creatorName.size() >= 1 && data.creatorName.size() <= 80 &&
        (!('creatorAvatar' in data) || (data.creatorAvatar is string && data.creatorAvatar.size() <= 500)) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 150 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 3000)) &&
        data.videoUrl is string && data.videoUrl.size() >= 1 && data.videoUrl.size() <= 500 &&
        (!('thumbnailUrl' in data) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 500)) &&
        data.type in ['video', 'short'] &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 50 &&
        data.language is string && data.language.size() >= 1 && data.language.size() <= 30 &&
        (!('durationSeconds' in data) || (data.durationSeconds is number && data.durationSeconds >= 0 && data.durationSeconds <= 86400)) &&
        (!('musicTrack' in data) || (data.musicTrack is string && data.musicTrack.size() <= 120)) &&
        (!('challengeId' in data) || (data.challengeId is string && data.challengeId.size() <= 128)) &&
        (!('tags' in data) || (data.tags is list && data.tags.size() <= 10 && (data.tags.size() == 0 || data.tags[0] is string))) &&
        (!('chapters' in data) || (data.chapters is list && data.chapters.size() <= 25 && (data.chapters.size() == 0 || data.chapters[0] is map))) &&
        (!('viewsCount' in data) || (data.viewsCount is number && data.viewsCount >= 0)) &&
        (!('uniqueViewersCount' in data) || (data.uniqueViewersCount is number && data.uniqueViewersCount >= 0)) &&
        (!('totalWatchSeconds' in data) || (data.totalWatchSeconds is number && data.totalWatchSeconds >= 0)) &&
        (!('likesCount' in data) || (data.likesCount is number && data.likesCount >= 0)) &&
        (!('dislikesCount' in data) || (data.dislikesCount is number && data.dislikesCount >= 0)) &&
        (!('commentsCount' in data) || (data.commentsCount is number && data.commentsCount >= 0)) &&
        (!('sharesCount' in data) || (data.sharesCount is number && data.sharesCount >= 0)) &&
        data.status in ['published', 'flagged', 'removed'] &&
        (!('removalReason' in data) || (data.removalReason is string && data.removalReason.size() <= 500)) &&
        (!('removedBy' in data) || (data.removedBy is string && data.removedBy.size() <= 128)) &&
        (!('isTrending' in data) || data.isTrending is bool) &&
        (!('isEarlyCreatorSpotlight' in data) || data.isEarlyCreatorSpotlight is bool) &&
        (!('isOriginal' in data) || data.isOriginal is bool) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidComment(data) {
      return data.keys().hasAll(['videoId', 'authorId', 'authorName', 'text', 'createdAt']) &&
        data.keys().hasOnly(['videoId', 'authorId', 'authorName', 'authorAvatar', 'text', 'parentCommentId', 'likesCount', 'createdAt']) &&
        isValidId(data.videoId) &&
        isValidId(data.authorId) &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
        (!('authorAvatar' in data) || (data.authorAvatar is string && data.authorAvatar.size() <= 500)) &&
        data.text is string && data.text.size() >= 1 && data.text.size() <= 1000 &&
        (!('parentCommentId' in data) || (data.parentCommentId is string && data.parentCommentId.size() <= 128)) &&
        (!('likesCount' in data) || (data.likesCount is number && data.likesCount >= 0)) &&
        data.createdAt is timestamp;
    }

    function isValidReaction(data) {
      return data.keys().hasAll(['videoId', 'userId', 'type', 'createdAt']) &&
        data.keys().hasOnly(['videoId', 'userId', 'type', 'createdAt']) &&
        isValidId(data.videoId) &&
        isValidId(data.userId) &&
        data.type in ['like', 'dislike'] &&
        data.createdAt is timestamp;
    }

    function isValidSubscription(data) {
      return data.keys().hasAll(['subscriberId', 'creatorId', 'createdAt']) &&
        data.keys().hasOnly(['subscriberId', 'creatorId', 'creatorName', 'creatorAvatar', 'createdAt']) &&
        isValidId(data.subscriberId) &&
        isValidId(data.creatorId) &&
        (!('creatorName' in data) || (data.creatorName is string && data.creatorName.size() <= 80)) &&
        (!('creatorAvatar' in data) || (data.creatorAvatar is string && data.creatorAvatar.size() <= 500)) &&
        data.createdAt is timestamp;
    }

    function isValidPlaylist(data) {
      return data.keys().hasAll(['ownerId', 'title', 'visibility', 'videoIds', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'ownerName', 'title', 'description', 'visibility', 'videoIds', 'thumbnailUrl', 'createdAt', 'updatedAt']) &&
        isValidId(data.ownerId) &&
        (!('ownerName' in data) || (data.ownerName is string && data.ownerName.size() <= 80)) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
        data.visibility in ['public', 'private'] &&
        data.videoIds is list && data.videoIds.size() <= 50 &&
        (data.videoIds.size() == 0 || data.videoIds[0] is string) &&
        (!('thumbnailUrl' in data) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 500)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidWatchHistory(data) {
      return data.keys().hasAll(['userId', 'videoId', 'title', 'progressSeconds', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'videoId', 'title', 'thumbnailUrl', 'creatorName', 'durationSeconds', 'progressSeconds', 'maxProgressSeconds', 'updatedAt']) &&
        isValidId(data.userId) &&
        isValidId(data.videoId) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
        (!('thumbnailUrl' in data) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 500)) &&
        (!('creatorName' in data) || (data.creatorName is string && data.creatorName.size() <= 80)) &&
        (!('durationSeconds' in data) || (data.durationSeconds is number && data.durationSeconds >= 0)) &&
        data.progressSeconds is number && data.progressSeconds >= 0 &&
        (!('maxProgressSeconds' in data) || (data.maxProgressSeconds is number && data.maxProgressSeconds >= 0)) &&
        data.updatedAt is timestamp;
    }

    function isValidWatchLater(data) {
      return data.keys().hasAll(['userId', 'videoId', 'title', 'createdAt']) &&
        data.keys().hasOnly(['userId', 'videoId', 'title', 'thumbnailUrl', 'creatorId', 'creatorName', 'durationSeconds', 'type', 'createdAt']) &&
        isValidId(data.userId) &&
        isValidId(data.videoId) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
        (!('thumbnailUrl' in data) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 500)) &&
        (!('creatorId' in data) || isValidId(data.creatorId)) &&
        (!('creatorName' in data) || (data.creatorName is string && data.creatorName.size() <= 80)) &&
        (!('durationSeconds' in data) || (data.durationSeconds is number && data.durationSeconds >= 0)) &&
        (!('type' in data) || data.type in ['video', 'short']) &&
        data.createdAt is timestamp;
    }

    function isValidCommunityPost(data) {
      return data.keys().hasAll(['creatorId', 'creatorName', 'content', 'postType', 'createdAt']) &&
        data.keys().hasOnly(['creatorId', 'creatorName', 'creatorAvatar', 'content', 'imageUrl', 'postType', 'pollOptions', 'pollVotes', 'likesCount', 'createdAt']) &&
        isValidId(data.creatorId) &&
        data.creatorName is string && data.creatorName.size() >= 1 && data.creatorName.size() <= 80 &&
        (!('creatorAvatar' in data) || (data.creatorAvatar is string && data.creatorAvatar.size() <= 500)) &&
        data.content is string && data.content.size() >= 1 && data.content.size() <= 1500 &&
        (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 500)) &&
        data.postType in ['text', 'image', 'poll', 'announcement'] &&
        (!('pollOptions' in data) || (data.pollOptions is list && data.pollOptions.size() <= 4 && (data.pollOptions.size() == 0 || data.pollOptions[0] is string))) &&
        (!('pollVotes' in data) || (data.pollVotes is list && data.pollVotes.size() <= 4 && (data.pollVotes.size() == 0 || data.pollVotes[0] is number))) &&
        (!('likesCount' in data) || (data.likesCount is number && data.likesCount >= 0)) &&
        data.createdAt is timestamp;
    }

    function isValidCreatorSupport(data) {
      return data.keys().hasAll(['supporterId', 'creatorId', 'amountInr', 'createdAt']) &&
        data.keys().hasOnly(['supporterId', 'supporterName', 'creatorId', 'creatorName', 'amountInr', 'message', 'createdAt']) &&
        isValidId(data.supporterId) &&
        (!('supporterName' in data) || (data.supporterName is string && data.supporterName.size() <= 80)) &&
        isValidId(data.creatorId) &&
        (!('creatorName' in data) || (data.creatorName is string && data.creatorName.size() <= 80)) &&
        data.amountInr is number && data.amountInr >= 10 && data.amountInr <= 50000 &&
        (!('message' in data) || (data.message is string && data.message.size() <= 280)) &&
        data.createdAt is timestamp;
    }

    function isValidCollaboration(data) {
      return data.keys().hasAll(['senderId', 'senderName', 'recipientId', 'recipientName', 'title', 'proposal', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['senderId', 'senderName', 'senderAvatar', 'recipientId', 'recipientName', 'recipientAvatar', 'title', 'proposal', 'status', 'createdAt', 'updatedAt']) &&
        isValidId(data.senderId) &&
        data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80 &&
        (!('senderAvatar' in data) || (data.senderAvatar is string && data.senderAvatar.size() <= 500)) &&
        isValidId(data.recipientId) &&
        data.recipientName is string && data.recipientName.size() >= 1 && data.recipientName.size() <= 80 &&
        (!('recipientAvatar' in data) || (data.recipientAvatar is string && data.recipientAvatar.size() <= 500)) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
        data.proposal is string && data.proposal.size() >= 5 && data.proposal.size() <= 800 &&
        data.status in ['pending', 'accepted', 'rejected'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidWatchParty(data) {
      return data.keys().hasAll(['hostId', 'hostName', 'title', 'videoId', 'videoTitle', 'videoUrl', 'inviteCode', 'isPrivate', 'isPlaying', 'currentTimeSeconds', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['hostId', 'hostName', 'title', 'videoId', 'videoTitle', 'videoUrl', 'thumbnailUrl', 'inviteCode', 'isPrivate', 'isPlaying', 'currentTimeSeconds', 'status', 'createdAt', 'updatedAt']) &&
        isValidId(data.hostId) &&
        data.hostName is string && data.hostName.size() >= 1 && data.hostName.size() <= 80 &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
        isValidId(data.videoId) &&
        data.videoTitle is string && data.videoTitle.size() >= 1 && data.videoTitle.size() <= 150 &&
        data.videoUrl is string && data.videoUrl.size() >= 1 && data.videoUrl.size() <= 500 &&
        (!('thumbnailUrl' in data) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 500)) &&
        data.inviteCode is string && data.inviteCode.size() >= 4 && data.inviteCode.size() <= 32 &&
        data.isPrivate is bool &&
        data.isPlaying is bool &&
        data.currentTimeSeconds is number && data.currentTimeSeconds >= 0 &&
        data.status in ['active', 'ended'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidWatchPartyMessage(data) {
      return data.keys().hasAll(['roomId', 'senderId', 'senderName', 'text', 'createdAt']) &&
        data.keys().hasOnly(['roomId', 'senderId', 'senderName', 'senderAvatar', 'text', 'createdAt']) &&
        isValidId(data.roomId) &&
        isValidId(data.senderId) &&
        data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80 &&
        (!('senderAvatar' in data) || (data.senderAvatar is string && data.senderAvatar.size() <= 500)) &&
        data.text is string && data.text.size() >= 1 && data.text.size() <= 400 &&
        data.createdAt is timestamp;
    }

    function isValidLiveStream(data) {
      return data.keys().hasAll(['creatorId', 'creatorName', 'title', 'isLive', 'startedAt']) &&
        data.keys().hasOnly(['creatorId', 'creatorName', 'creatorAvatar', 'title', 'description', 'category', 'language', 'thumbnailUrl', 'streamUrl', 'isLive', 'viewerCount', 'startedAt']) &&
        isValidId(data.creatorId) &&
        data.creatorName is string && data.creatorName.size() >= 1 && data.creatorName.size() <= 80 &&
        (!('creatorAvatar' in data) || (data.creatorAvatar is string && data.creatorAvatar.size() <= 500)) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 150 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
        (!('category' in data) || (data.category is string && data.category.size() <= 50)) &&
        (!('language' in data) || (data.language is string && data.language.size() <= 30)) &&
        (!('thumbnailUrl' in data) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 500)) &&
        (!('streamUrl' in data) || (data.streamUrl is string && data.streamUrl.size() <= 500)) &&
        data.isLive is bool &&
        (!('viewerCount' in data) || (data.viewerCount is number && data.viewerCount >= 0)) &&
        data.startedAt is timestamp;
    }

    function isValidLiveChatMessage(data) {
      return data.keys().hasAll(['streamId', 'senderId', 'senderName', 'text', 'createdAt']) &&
        data.keys().hasOnly(['streamId', 'senderId', 'senderName', 'senderAvatar', 'text', 'superSupportInr', 'createdAt']) &&
        isValidId(data.streamId) &&
        isValidId(data.senderId) &&
        data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80 &&
        (!('senderAvatar' in data) || (data.senderAvatar is string && data.senderAvatar.size() <= 500)) &&
        data.text is string && data.text.size() >= 1 && data.text.size() <= 400 &&
        (!('superSupportInr' in data) || (data.superSupportInr is number && data.superSupportInr >= 0 && data.superSupportInr <= 50000)) &&
        data.createdAt is timestamp;
    }

    function isValidChallenge(data) {
      return data.keys().hasAll(['title', 'description', 'prizePoolInr', 'status', 'createdAt']) &&
        data.keys().hasOnly(['title', 'description', 'prizePoolInr', 'category', 'deadline', 'participantsCount', 'status', 'createdAt']) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
        data.description is string && data.description.size() >= 5 && data.description.size() <= 1000 &&
        data.prizePoolInr is number && data.prizePoolInr >= 0 &&
        (!('category' in data) || (data.category is string && data.category.size() <= 50)) &&
        (!('deadline' in data) || (data.deadline is string && data.deadline.size() <= 40)) &&
        (!('participantsCount' in data) || (data.participantsCount is number && data.participantsCount >= 0)) &&
        data.status in ['active', 'ended'] &&
        data.createdAt is timestamp;
    }

    function isValidCompetition(data) {
      return data.keys().hasAll(['title', 'monthLabel', 'description', 'prizePoolInr', 'status', 'createdAt']) &&
        data.keys().hasOnly(['title', 'monthLabel', 'description', 'prizePoolInr', 'categories', 'winnerCreatorId', 'winnerCreatorName', 'status', 'createdAt']) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
        data.monthLabel is string && data.monthLabel.size() >= 2 && data.monthLabel.size() <= 40 &&
        data.description is string && data.description.size() >= 5 && data.description.size() <= 1000 &&
        data.prizePoolInr is number && data.prizePoolInr >= 0 &&
        (!('categories' in data) || (data.categories is list && data.categories.size() <= 10 && (data.categories.size() == 0 || data.categories[0] is string))) &&
        (!('winnerCreatorId' in data) || (data.winnerCreatorId is string && data.winnerCreatorId.size() <= 128)) &&
        (!('winnerCreatorName' in data) || (data.winnerCreatorName is string && data.winnerCreatorName.size() <= 80)) &&
        data.status in ['active', 'completed'] &&
        data.createdAt is timestamp;
    }

    function isValidAnnouncement(data) {
      return data.keys().hasAll(['title', 'body', 'category', 'isActive', 'createdAt']) &&
        data.keys().hasOnly(['title', 'body', 'category', 'createdBy', 'isActive', 'createdAt']) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
        data.body is string && data.body.size() >= 3 && data.body.size() <= 600 &&
        data.category in ['feature', 'league', 'policy', 'event'] &&
        (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 80)) &&
        data.isActive is bool &&
        data.createdAt is timestamp;
    }

    function isValidReport(data) {
      return data.keys().hasAll(['reporterId', 'targetType', 'targetId', 'reason', 'status', 'createdAt']) &&
        data.keys().hasOnly(['reporterId', 'targetType', 'targetId', 'targetTitle', 'reason', 'status', 'createdAt']) &&
        isValidId(data.reporterId) &&
        data.targetType in ['video', 'comment', 'user'] &&
        isValidId(data.targetId) &&
        (!('targetTitle' in data) || (data.targetTitle is string && data.targetTitle.size() <= 150)) &&
        data.reason is string && data.reason.size() >= 3 && data.reason.size() <= 500 &&
        data.status in ['pending', 'reviewed', 'resolved', 'dismissed'] &&
        data.createdAt is timestamp;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['recipientId', 'type', 'title', 'message', 'isRead', 'createdAt']) &&
        data.keys().hasOnly(['recipientId', 'senderName', 'type', 'title', 'message', 'linkPath', 'isRead', 'createdAt']) &&
        isValidId(data.recipientId) &&
        (!('senderName' in data) || (data.senderName is string && data.senderName.size() <= 80)) &&
        data.type in ['live', 'upload', 'comment', 'support', 'reward', 'system', 'subscriber', 'like', 'collaboration', 'announcement'] &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 300 &&
        (!('linkPath' in data) || (data.linkPath is string && data.linkPath.size() <= 200)) &&
        data.isRead is bool &&
        data.createdAt is timestamp;
    }

    function isValidPlatformConfig(data) {
      return data.keys().hasAll(['categories', 'languages', 'earlyCreatorBoostEnabled', 'creatorRevenueSharePercent', 'updatedAt']) &&
        data.keys().hasOnly(['categories', 'languages', 'earlyCreatorBoostEnabled', 'creatorRevenueSharePercent', 'maintenanceMode', 'updatedAt']) &&
        data.categories is list && data.categories.size() <= 20 && (data.categories.size() == 0 || data.categories[0] is string) &&
        data.languages is list && data.languages.size() <= 20 && (data.languages.size() == 0 || data.languages[0] is string) &&
        data.earlyCreatorBoostEnabled is bool &&
        data.creatorRevenueSharePercent is number && data.creatorRevenueSharePercent >= 0 && data.creatorRevenueSharePercent <= 100 &&
        (!('maintenanceMode' in data) || data.maintenanceMode is bool) &&
        data.updatedAt is timestamp;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if resource.data.isCreator == true || isAdmin() || isCEO();
      allow create: if isValidId(userId) && isVerifiedUser() &&
        isValidPublicProfile(incoming()) &&
        (isAdmin() || incoming().uid == request.auth.uid) &&
        incoming().uid == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (!('isVerified' in incoming()) || incoming().isVerified == false || isAdmin()) &&
        (!('isFeatured' in incoming()) || incoming().isFeatured == false || isAdmin()) &&
        (!('boostEnabled' in incoming()) || incoming().boostEnabled == false || isAdmin()) &&
        (!('accountStatus' in incoming()) || incoming().accountStatus == 'active' || isCEO()) &&
        (!('channelStatus' in incoming()) || incoming().channelStatus == 'active' || isCEO());

      allow update: if isValidId(userId) && isVerifiedUser() && isValidPublicProfile(incoming()) && (
        isCEO() ||
        (
          isAdmin() &&
          (!('accountStatus' in incoming()) || !('accountStatus' in existing()) || incoming().accountStatus == existing().accountStatus) &&
          (!('channelStatus' in incoming()) || !('channelStatus' in existing()) || incoming().channelStatus == existing().channelStatus)
        ) ||
        (
          isOwner(userId) &&
          incoming().uid == existing().uid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'handle', 'bio', 'avatarUrl', 'bannerUrl', 'isCreator', 'isEarlyCreator', 'preferredLanguage', 'leagueCategory', 'updatedAt'])
        ) ||
        (
          incoming().uid == existing().uid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['subscribersCount', 'updatedAt'])
        ) ||
        (
          incoming().uid == existing().uid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['totalViews', 'updatedAt'])
        )
      );

      // Permanent account deletion strictly reserved for CEO
      allow delete: if isValidId(userId) && isCEO();

      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin() || isCEO());
        allow list: if isOwner(userId) || isAdmin() || isCEO();
        allow create: if isValidId(userId) && isValidId(docId) && isVerifiedUser() &&
          isValidPrivateAccount(incoming()) &&
          (
            isCEO() ||
            (
              incoming().uid == request.auth.uid &&
              incoming().uid == userId &&
              incoming().updatedAt == request.time &&
              incoming().role in ['viewer', 'creator']
            )
          );

        allow update: if isValidId(userId) && isValidId(docId) && isVerifiedUser() && isValidPrivateAccount(incoming()) && (
          isCEO() ||
          (
            isAdmin() &&
            existing().role != 'ceo' &&
            incoming().role in ['viewer', 'creator', 'admin']
          ) ||
          (
            isOwner(userId) &&
            incoming().uid == existing().uid &&
            existing().role in ['viewer', 'creator'] &&
            incoming().role in ['viewer', 'creator'] &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly(['role', 'monetizationEnabled', 'upiId', 'notificationsEnabled', 'updatedAt'])
          )
        );
        allow delete: if isValidId(userId) && isValidId(docId) && isCEO();
      }

      match /watchHistory/{videoId} {
        allow get: if isValidId(userId) && isValidId(videoId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(videoId) && isVerifiedUser() &&
          isOwner(userId) &&
          isValidWatchHistory(incoming()) &&
          incoming().userId == request.auth.uid &&
          incoming().videoId == videoId &&
          incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(videoId) && isVerifiedUser() &&
          isOwner(userId) &&
          isValidWatchHistory(incoming()) &&
          incoming().userId == existing().userId &&
          incoming().videoId == existing().videoId &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['progressSeconds', 'maxProgressSeconds', 'durationSeconds', 'title', 'thumbnailUrl', 'creatorName', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(videoId) && (isOwner(userId) || isCEO());
      }

      match /watchLater/{videoId} {
        allow get: if isValidId(userId) && isValidId(videoId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(videoId) && isVerifiedUser() &&
          isOwner(userId) &&
          isValidWatchLater(incoming()) &&
          incoming().userId == request.auth.uid &&
          incoming().videoId == videoId &&
          incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(videoId) && (isOwner(userId) || isCEO());
      }
    }

    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isAdmin() || isCEO());
      allow list: if isAdmin() || isCEO();
      allow create, update, delete: if isValidId(adminId) && isCEO();
    }

    match /ceoRoles/{ceoId} {
      allow get: if isValidId(ceoId) && isCEO();
      allow list: if isCEO();
      allow create, update: if isValidId(ceoId) && isCEO() &&
        isValidCeoRole(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().grantedAt == request.time;
      allow delete: if false;
    }

    match /ceoAuditLogs/{logId} {
      allow get: if isValidId(logId) && isCEO();
      allow list: if isCEO();
      allow create: if isValidId(logId) && isCEO() &&
        isValidCeoAuditLog(incoming()) &&
        incoming().actorUid == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    match /videos/{videoId} {
      allow get: if isValidId(videoId) && (resource.data.status == 'published' || (isSignedIn() && resource.data.creatorId == request.auth.uid) || isAdmin() || isCEO());
      allow list: if resource.data.status == 'published' || (isSignedIn() && resource.data.creatorId == request.auth.uid) || isAdmin() || isCEO();

      allow create: if isValidId(videoId) && isVerifiedUser() &&
        isValidVideo(incoming()) &&
        (isAdmin() || incoming().creatorId == request.auth.uid) &&
        incoming().status == 'published' &&
        (!('isOriginal' in incoming()) || incoming().isOriginal == false || isAdmin()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(videoId) && isVerifiedUser() && isValidVideo(incoming()) && (
        isCEO() ||
        isAdmin() ||
        (
          existing().status != 'removed' &&
          existing().creatorId == request.auth.uid &&
          incoming().creatorId == existing().creatorId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'thumbnailUrl', 'category', 'language', 'tags', 'chapters', 'musicTrack', 'updatedAt'])
        ) ||
        (
          existing().status == 'published' &&
          incoming().creatorId == existing().creatorId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['viewsCount', 'uniqueViewersCount', 'totalWatchSeconds', 'updatedAt'])
        ) ||
        (
          existing().status == 'published' &&
          incoming().creatorId == existing().creatorId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'dislikesCount', 'updatedAt'])
        ) ||
        (
          existing().status == 'published' &&
          incoming().creatorId == existing().creatorId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['commentsCount', 'updatedAt'])
        ) ||
        (
          existing().status == 'published' &&
          incoming().creatorId == existing().creatorId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['sharesCount', 'updatedAt'])
        )
      );

      allow delete: if isValidId(videoId) && isVerifiedUser() && (existing().creatorId == request.auth.uid || isCEO());

      match /comments/{commentId} {
        allow get: if isValidId(videoId) && isValidId(commentId);
        allow list: if resource.data.videoId == videoId;
        allow create: if isValidId(videoId) && isValidId(commentId) && isVerifiedUser() &&
          isValidComment(incoming()) &&
          incoming().videoId == videoId &&
          incoming().authorId == request.auth.uid &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/videos/$(videoId));
        allow update: if isValidId(videoId) && isValidId(commentId) && isVerifiedUser() && isValidComment(incoming()) && (
          isAdmin() ||
          (
            existing().authorId == request.auth.uid &&
            incoming().authorId == existing().authorId &&
            incoming().videoId == existing().videoId &&
            incoming().createdAt == existing().createdAt &&
            incoming().diff(existing()).affectedKeys().hasOnly(['text'])
          ) ||
          (
            incoming().authorId == existing().authorId &&
            incoming().videoId == existing().videoId &&
            incoming().createdAt == existing().createdAt &&
            incoming().diff(existing()).affectedKeys().hasOnly(['likesCount'])
          )
        );
        allow delete: if isValidId(videoId) && isValidId(commentId) && isVerifiedUser() && (existing().authorId == request.auth.uid || isAdmin());
      }

      match /reactions/{userId} {
        allow get: if isValidId(videoId) && isValidId(userId) && isOwner(userId);
        allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
        allow create: if isValidId(videoId) && isValidId(userId) && isVerifiedUser() &&
          isOwner(userId) &&
          isValidReaction(incoming()) &&
          incoming().videoId == videoId &&
          incoming().userId == request.auth.uid &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/videos/$(videoId));
        allow update: if isValidId(videoId) && isValidId(userId) && isVerifiedUser() &&
          isOwner(userId) &&
          isValidReaction(incoming()) &&
          incoming().videoId == existing().videoId &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['type']);
        allow delete: if isValidId(videoId) && isValidId(userId) && isOwner(userId);
      }
    }

    match /subscriptions/{subId} {
      allow get: if isValidId(subId) && isSignedIn() && (resource.data.subscriberId == request.auth.uid || resource.data.creatorId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.subscriberId == request.auth.uid || resource.data.creatorId == request.auth.uid || isAdmin());
      allow create: if isValidId(subId) && isVerifiedUser() &&
        isValidSubscription(incoming()) &&
        incoming().subscriberId == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(subId) && isVerifiedUser() && (existing().subscriberId == request.auth.uid || isAdmin());
    }

    match /playlists/{playlistId} {
      allow get: if isValidId(playlistId) && (resource.data.visibility == 'public' || (isSignedIn() && resource.data.ownerId == request.auth.uid) || isAdmin());
      allow list: if resource.data.visibility == 'public' || (isSignedIn() && resource.data.ownerId == request.auth.uid) || isAdmin();
      allow create: if isValidId(playlistId) && isVerifiedUser() &&
        isValidPlaylist(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(playlistId) && isVerifiedUser() && isValidPlaylist(incoming()) && (
        isAdmin() ||
        (
          existing().ownerId == request.auth.uid &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'visibility', 'videoIds', 'thumbnailUrl', 'updatedAt'])
        )
      );
      allow delete: if isValidId(playlistId) && isVerifiedUser() && (existing().ownerId == request.auth.uid || isAdmin());
    }

    match /communityPosts/{postId} {
      allow get: if isValidId(postId);
      allow list: if resource.data.postType in ['text', 'image', 'poll', 'announcement'];
      allow create: if isValidId(postId) && isVerifiedUser() &&
        isValidCommunityPost(incoming()) &&
        (isAdmin() || incoming().creatorId == request.auth.uid) &&
        incoming().createdAt == request.time;
      allow update: if isValidId(postId) && isVerifiedUser() && isValidCommunityPost(incoming()) && (
        isAdmin() ||
        (
          existing().creatorId == request.auth.uid &&
          incoming().creatorId == existing().creatorId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['content', 'imageUrl'])
        ) ||
        (
          incoming().creatorId == existing().creatorId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['pollVotes'])
        ) ||
        (
          incoming().creatorId == existing().creatorId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['likesCount'])
        )
      );
      allow delete: if isValidId(postId) && isVerifiedUser() && (existing().creatorId == request.auth.uid || isAdmin());
    }

    match /creatorSupports/{supportId} {
      allow get: if isValidId(supportId) && isSignedIn() && (resource.data.supporterId == request.auth.uid || resource.data.creatorId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.supporterId == request.auth.uid || resource.data.creatorId == request.auth.uid || isAdmin());
      allow create: if isValidId(supportId) && isVerifiedUser() &&
        isValidCreatorSupport(incoming()) &&
        incoming().supporterId == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(supportId) && isAdmin();
    }

    match /collaborations/{collabId} {
      allow get: if isValidId(collabId) && (resource.data.status == 'accepted' || (isSignedIn() && (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid)) || isAdmin());
      allow list: if resource.data.status == 'accepted' || (isSignedIn() && (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid)) || isAdmin();
      allow create: if isValidId(collabId) && isVerifiedUser() &&
        isValidCollaboration(incoming()) &&
        incoming().senderId == request.auth.uid &&
        incoming().recipientId != request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(collabId) && isVerifiedUser() && isValidCollaboration(incoming()) && (
        isAdmin() ||
        (
          existing().recipientId == request.auth.uid &&
          existing().status == 'pending' &&
          incoming().senderId == existing().senderId &&
          incoming().recipientId == existing().recipientId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
          incoming().status in ['accepted', 'rejected']
        )
      );
      allow delete: if isValidId(collabId) && isVerifiedUser() && (existing().senderId == request.auth.uid || isAdmin());
    }

    match /watchParties/{roomId} {
      allow get: if isValidId(roomId) && isSignedIn();
      allow list: if resource.data.isPrivate == false || (isSignedIn() && resource.data.hostId == request.auth.uid) || isAdmin();
      allow create: if isValidId(roomId) && isVerifiedUser() &&
        isValidWatchParty(incoming()) &&
        incoming().hostId == request.auth.uid &&
        incoming().status == 'active' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(roomId) && isVerifiedUser() && isValidWatchParty(incoming()) && (
        isAdmin() ||
        (
          existing().hostId == request.auth.uid &&
          incoming().hostId == existing().hostId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['videoId', 'videoTitle', 'videoUrl', 'thumbnailUrl', 'isPlaying', 'currentTimeSeconds', 'status', 'isPrivate', 'title', 'updatedAt'])
        )
      );
      allow delete: if isValidId(roomId) && isVerifiedUser() && (existing().hostId == request.auth.uid || isAdmin());

      match /messages/{messageId} {
        allow get: if isValidId(roomId) && isValidId(messageId) && isSignedIn();
        allow list: if isSignedIn() && resource.data.roomId == roomId;
        allow create: if isValidId(roomId) && isValidId(messageId) && isVerifiedUser() &&
          isValidWatchPartyMessage(incoming()) &&
          incoming().roomId == roomId &&
          incoming().senderId == request.auth.uid &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/watchParties/$(roomId));
        allow update: if false;
        allow delete: if isValidId(roomId) && isValidId(messageId) && isVerifiedUser() && (existing().senderId == request.auth.uid || isAdmin());
      }
    }

    match /liveStreams/{streamId} {
      allow get: if isValidId(streamId);
      allow list: if resource.data.isLive == true || (isSignedIn() && resource.data.creatorId == request.auth.uid) || isAdmin();
      allow create: if isValidId(streamId) && isVerifiedUser() &&
        isValidLiveStream(incoming()) &&
        (isAdmin() || incoming().creatorId == request.auth.uid) &&
        incoming().startedAt == request.time;
      allow update: if isValidId(streamId) && isVerifiedUser() && isValidLiveStream(incoming()) && (
        isAdmin() ||
        (
          existing().creatorId == request.auth.uid &&
          incoming().creatorId == existing().creatorId &&
          incoming().startedAt == existing().startedAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'isLive', 'thumbnailUrl', 'streamUrl'])
        ) ||
        (
          incoming().creatorId == existing().creatorId &&
          incoming().startedAt == existing().startedAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['viewerCount'])
        )
      );
      allow delete: if isValidId(streamId) && isVerifiedUser() && (existing().creatorId == request.auth.uid || isAdmin());

      match /messages/{messageId} {
        allow get: if isValidId(streamId) && isValidId(messageId);
        allow list: if resource.data.streamId == streamId;
        allow create: if isValidId(streamId) && isValidId(messageId) && isVerifiedUser() &&
          isValidLiveChatMessage(incoming()) &&
          incoming().streamId == streamId &&
          incoming().senderId == request.auth.uid &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/liveStreams/$(streamId));
        allow update: if false;
        allow delete: if isValidId(streamId) && isValidId(messageId) && isVerifiedUser() && (existing().senderId == request.auth.uid || isAdmin());
      }
    }

    match /challenges/{challengeId} {
      allow get: if isValidId(challengeId);
      allow list: if resource.data.status in ['active', 'ended'];
      allow create: if isValidId(challengeId) && isAdmin() &&
        isValidChallenge(incoming()) &&
        incoming().createdAt == request.time;
      allow update: if isValidId(challengeId) && isVerifiedUser() && isValidChallenge(incoming()) && (
        isAdmin() ||
        (
          existing().status == 'active' &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['participantsCount'])
        )
      );
      allow delete: if isValidId(challengeId) && isAdmin();
    }

    match /competitions/{compId} {
      allow get: if isValidId(compId);
      allow list: if resource.data.status in ['active', 'completed'];
      allow create: if isValidId(compId) && isAdmin() &&
        isValidCompetition(incoming()) &&
        incoming().createdAt == request.time;
      allow update: if isValidId(compId) && isAdmin() &&
        isValidCompetition(incoming()) &&
        incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(compId) && isAdmin();
    }

    match /announcements/{announcementId} {
      allow get: if isValidId(announcementId) && (resource.data.isActive == true || isAdmin() || isCEO());
      allow list: if resource.data.isActive == true || isAdmin() || isCEO();
      allow create: if isValidId(announcementId) && (isAdmin() || isCEO()) &&
        isValidAnnouncement(incoming()) &&
        incoming().createdAt == request.time;
      allow update: if isValidId(announcementId) && (isAdmin() || isCEO()) &&
        isValidAnnouncement(incoming()) &&
        incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(announcementId) && (isAdmin() || isCEO());
    }

    match /reports/{reportId} {
      allow get: if isValidId(reportId) && isSignedIn() && (resource.data.reporterId == request.auth.uid || isAdmin() || isCEO());
      allow list: if isSignedIn() && (resource.data.reporterId == request.auth.uid || isAdmin() || isCEO());
      allow create: if isValidId(reportId) && isVerifiedUser() &&
        isValidReport(incoming()) &&
        incoming().reporterId == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time;
      allow update: if isValidId(reportId) && (isAdmin() || isCEO()) && isValidReport(incoming()) &&
        incoming().reporterId == existing().reporterId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      allow delete: if isValidId(reportId) && isCEO();
    }

    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && isSignedIn() && (resource.data.recipientId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.recipientId == request.auth.uid || isAdmin());
      allow create: if isValidId(notificationId) && isVerifiedUser() &&
        isValidNotification(incoming()) &&
        (isAdmin() || incoming().isRead == false) &&
        incoming().createdAt == request.time;
      allow update: if isValidId(notificationId) && isVerifiedUser() && isValidNotification(incoming()) && (
        isAdmin() ||
        (
          existing().recipientId == request.auth.uid &&
          incoming().recipientId == existing().recipientId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['isRead'])
        )
      );
      allow delete: if isValidId(notificationId) && isVerifiedUser() && (existing().recipientId == request.auth.uid || isAdmin());
    }

    match /platformConfig/{configId} {
      allow get: if isValidId(configId);
      allow list: if resource.data.earlyCreatorBoostEnabled is bool;
      allow create, update: if isValidId(configId) && isAdmin() &&
        isValidPlatformConfig(incoming()) &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(configId) && isCEO();
    }
  }
}
